# Скопируй в локальный .env/экспортируй в shell. Этот файл не содержит секретов.
SIGCOPY_MT5_URL=http://127.0.0.1:22346/mcp
SIGCOPY_MT5_TOKEN=
SIGCOPY_EXECUTION_ENABLE=0
SIGCOPY_ALLOW_LIVE=0
SIGCOPY_ALLOWED_SERVERS=MetaQuotes-Demo
SIGCOPY_ALLOWED_ACCOUNT_LOGINS=
SIGCOPY_ALLOWED_ACCOUNT_TYPES=demo

# По умолчанию свободный текст разбирает локальная модель.
SIGCOPY_LLM=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=llava

# Необязательный Telegram-вход. Только явный allowlist, без автоторговли.
SIGCOPY_TG_BOT_TOKEN=
SIGCOPY_TG_CHAT_IDS=
SIGCOPY_TG_USER_IDS=
SIGCOPY_TG_PRIVATE_ONLY=1
SIGCOPY_TG_USE_LLM=0

# Можно задать постоянный локальный UI-токен; иначе он случайный при каждом запуске.
SIGCOPY_WEB_TOKEN=

# Реальный счёт остаётся запрещённым в коде до отдельного review/deploy gate.
