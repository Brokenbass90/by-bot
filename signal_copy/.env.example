# Скопируй этот файл в .env (рядом, в signal_copy/) и подставь свои значения.
# .env читается при старте app.py. В git его класть не надо.

# Ключ из MetaTrader 5: Сервис → Настройки → MCP → поле «Ключ API».
# Меняется каждый раз, когда там нажимают «Генерировать».
SIGCOPY_MT5_TOKEN=вставь_сюда_ключ

# Адрес MCP-сервера терминала (обычно менять не нужно)
# SIGCOPY_MT5_URL=http://127.0.0.1:22346/mcp

# ── риск ──
# SIGCOPY_RISK_PCT=0.5
# SIGCOPY_MAX_RISK_PCT=2.0
# SIGCOPY_MAX_LOT=0.50
# SIGCOPY_MAX_POSITIONS=3
# SIGCOPY_DEFAULT_TP=4

# ── замки: куда вообще можно торговать ──
# SIGCOPY_ALLOWED_SERVERS=MetaQuotes-Demo
# SIGCOPY_ALLOWED_ACCOUNT_LOGINS=
# SIGCOPY_ALLOWED_ACCOUNT_TYPES=demo
# SIGCOPY_ALLOW_LIVE=0

# ── главный рубильник: 0 = ордера не отправляются вообще ──
SIGCOPY_EXECUTION_ENABLE=0

# ── ИИ ──
# По умолчанию всё локально в Ollama, наружу ничего не уходит.
# SIGCOPY_LLM=ollama
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_VISION_MODEL=llava
# Включить DeepSeek можно только этим флагом — одного ключа мало:
# SIGCOPY_ALLOW_REMOTE_LLM=0
# DEEPSEEK_API_KEY=
