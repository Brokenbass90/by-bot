[Unit]
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=3
[Service]
User=bybot-polydata
DynamicUser=yes
StateDirectory=bybot-polydata-20261102
StateDirectoryMode=0700
UMask=0077
WorkingDirectory=@@APP@@
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=BYBIT_API_KEY BYBIT_API_SECRET BYBIT_ACCOUNTS_JSON ALPACA_API_KEY ALPACA_SECRET_KEY
Slice=poly-ws-data.slice
CPUQuota=10%
CPUWeight=10
MemoryMax=128M
TasksMax=16
Nice=15
IOSchedulingClass=idle
IOWeight=10
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
InaccessiblePaths=-/root -/home -/etc/ssl/private
ReadWritePaths=/var/lib/bybot-polydata-20261102
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=60
ExecStart=/usr/bin/python3 -B @@APP@@/scripts/run_polymarket_ws_data_v1.py --run-data-only --spec @@SPEC@@ --spec-sha256 @@PIN@@ --role clob
[Install]
WantedBy=multi-user.target
