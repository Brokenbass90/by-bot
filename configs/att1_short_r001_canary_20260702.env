# ─────────────────────────────────────────────────────────────────────────────
# ATT1 short-only r001 canary — proposal 2026-07-02
# Strategy: alt_trendline_touch_v1
# Status: PROPOSAL. Do not source on live without explicit owner OK.
#
# Evidence:
# - reports/ATT1_REVALIDATE_VERDICT_2026_07_02.md
# - reports/ATT1_SHORT_STRICT_OOS_GRADING_2026_07_02.md
# - reports/ATT1_SHORT_FEE_STRESS_2026_07_02.md
#
# r001 passed strict short-only grading:
# - 4/4 OOS folds positive
# - 239 short trades in fold grading
# - peak ratio 2.35 (not one-window hero)
# - fee/slippage stress survived:
#   * 6/2 bps: 290 trades, +27.77R, PF 1.402, DD 6.55
#   * 10/5 bps: 307 trades, +16.53R, PF 1.214, DD 8.46
#
# Migration rule:
# - migrate geometry only;
# - keep risk tiny at 0.10;
# - no risk increase until live edge_monitor is healthy after 10-20 live trades;
# - all increases later go through smart_risk + breaker + expiry.
# ─────────────────────────────────────────────────────────────────────────────

ENABLE_ATT1_TRADING=1
ATT1_RISK_MULT=0.10

# Side split: only the short side passed the strict promotion path.
ATT1_ALLOW_LONGS=0
ATT1_ALLOW_SHORTS=1

# Exact r001 geometry from strict-grading winner.
ATT1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ATT1_PIVOT_LEFT=2
ATT1_PIVOT_RIGHT=3
ATT1_MIN_PIVOTS=2
ATT1_MAX_PIVOT_AGE=16
ATT1_MIN_R2=0.55
ATT1_TOUCH_ATR=0.50
ATT1_RSI_LONG_MAX=52

# Keep every other unproven sleeve paused during the r001 canary migration.
FLAT_RISK_MULT=0.0
BREAKDOWN_RISK_MULT=0.0
RANGE_RISK_MULT=0.0
ASB1_RISK_MULT=0.0
BOUNCE1_RISK_MULT=0.0
HZBO1_RISK_MULT=0.0
IVB1_RISK_MULT=0.0
MIDTERM_RISK_MULT=0.0
SLOPED_RISK_MULT=0.0
ASM1_RISK_MULT=0.0
BRC1_RISK_MULT=0.0
ELDER_RISK_MULT=0.0

# Do not strangle ATT1; stack comparison showed cap>=3 preserves the edge.
MAX_POSITIONS=3
ATT1_MAX_OPEN_TRADES=3

# Auto-rollback breaker. Same live strategy id as the monolith journal.
ATT1_BREAKER_ENABLE=1
ATT1_BREAKER_STRATEGY_NAME=att1_trendline_touch
ATT1_BREAKER_LOOKBACK_DAYS=21
ATT1_BREAKER_MIN_TRADES=6
ATT1_BREAKER_SOFT_NET_PNL=-1.5
ATT1_BREAKER_SOFT_MULT=0.50
ATT1_BREAKER_HARD_NET_PNL=-3.0
ATT1_BREAKER_MAX_CONSEC_LOSSES=5
ATT1_BREAKER_ALERT_COOLDOWN_SEC=1800

# Forces review instead of an open-ended canary.
ATT1_CANARY_EXPIRY_UTC=2026-07-20
