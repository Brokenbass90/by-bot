# ─────────────────────────────────────────────────────────────────────────────
# ATT1 short-only crypto canary — proposal 2026-06-29
# Strategy: alt_trendline_touch_v1 (descending-resistance touch, SHORT side only)
# Status: PROPOSAL. Do NOT source on live until the GO gates in
#         reports/ATT1_SHORT_CANARY_GO_NOGO_2026_06_29.md are all green.
# Risk philosophy: tiny risk, short-only, explicit expiry + auto-rollback breaker.
# ─────────────────────────────────────────────────────────────────────────────

# ── Un-pause ATT1 at canary risk (floor in monolith is 0.05) ─────────────────
ATT1_RISK_MULT=0.10

# ── Short-only: strongest evidence is the short side (+28.02 vs long +9.33) ───
ATT1_ALLOW_LONGS=0
ATT1_ALLOW_SHORTS=1

# ── Keep every other unproven sleeve paused (do not co-launch) ───────────────
BREAKDOWN_RISK_MULT=0.0
RANGE_RISK_MULT=0.0
ASB1_RISK_MULT=0.0
ELDER_RISK_MULT=0.0

# ── Conservative live posture for the canary window ──────────────────────────
# (these mirror the safe runtime knobs; tune to match current live .env)
# stack_comparison (2026-06-29) on 365d ATT1-short journal: cap>=3 drops 0% of
# trades (PF 1.32 preserved); cap=2 drops ~10% (PF->1.27); cap=1 drops 35%.
# => 3 is the smallest cap that does not strangle ATT1's edge.
MAX_POSITIONS=3
ATT1_MAX_OPEN_TRADES=3

# Optional: bound symbols to the revalidated set. Leave empty to use the
# dynamic short-side universe router. Uncomment to pin a small allowlist.
# ATT1_SYMBOL_ALLOWLIST=

# ── ATT1 auto-rollback breaker (consumed by bot/strategy_breaker.py wiring) ──
# Hard-block -> ATT1 stops opening new trades; soft -> risk is cut.
ATT1_BREAKER_ENABLE=1
ATT1_BREAKER_STRATEGY_NAME=att1_trendline_touch
ATT1_BREAKER_LOOKBACK_DAYS=21
ATT1_BREAKER_MIN_TRADES=6
ATT1_BREAKER_SOFT_NET_PNL=-1.5
ATT1_BREAKER_SOFT_MULT=0.50
ATT1_BREAKER_HARD_NET_PNL=-3.0
ATT1_BREAKER_MAX_CONSEC_LOSSES=5
ATT1_BREAKER_ALERT_COOLDOWN_SEC=1800

# ── Canary expiry: after this UTC datetime the breaker hard-blocks ATT1 until a
#    human renews it (forces a review instead of an open-ended canary). ~21 days.
ATT1_CANARY_EXPIRY_UTC=2026-07-20
