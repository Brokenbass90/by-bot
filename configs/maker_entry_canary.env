# Maker-first execution canary for limit-natural level strategies.
# Market fallback is allowed only after a confirmed cancel and a fresh risk check.
MAKER_ENTRY_ENABLE=1
MAKER_ENTRY_STRATEGIES=range,flat_resistance_fade
MAKER_ENTRY_OFFSET_BPS=2.0
MAKER_ENTRY_WAIT_SEC=8.0
MAKER_ENTRY_POLL_SEC=1.0
MAKER_ENTRY_CANCEL_SETTLE_SEC=0.5
MAKER_ENTRY_MAX_ADVERSE_BPS=10.0
MAKER_ENTRY_MAX_RISK_EXPANSION=1.15
POST_FILL_MAX_RISK_EXPANSION=1.20
