ALPACA_SEND_ORDERS=1
ALPACA_CLOSE_STALE_POSITIONS=1

ALPACA_MAX_POSITIONS=2
ALPACA_TARGET_ALLOC_PCT=0.40
ALPACA_MIN_DOLLAR_ORDER=25
ALPACA_MAX_PICK_AGE_DAYS=45
ALPACA_ALLOW_STALE_PICKS=0
# Small deposit mode: set to actual deposit amount in USD
# For real live trading set ALPACA_CAPITAL_OVERRIDE_USD=0 to use full buying power
ALPACA_CAPITAL_OVERRIDE_USD=1000

ALPACA_AUTOPILOT_REFRESH=1
ALPACA_AUTOPILOT_REFRESH_SCRIPT=scripts/run_equities_monthly_v36_refresh.sh
ALPACA_AUTOPILOT_RUNTIME_DIR=runtime/equities_monthly_v36
EQ_V36_RUNTIME_DIR=runtime/equities_monthly_v36

# v38 monthly research gate: 2024-05..2026-04, BE 0.8R + 1.5 ATR trail in sim.
EQ_V36_TAG=equities_monthly_v38_candidate_refresh
EQ_V36_SIM_START_MONTH=2024-05
EQ_V36_SIM_END_MONTH=2026-04
EQ_V36_SIM_MAX_HOLD_DAYS=20
EQ_V36_SIM_MIN_MOM_LOOKBACK_PCT=5.0
EQ_V36_SIM_STOP_ATR_MULT=2.0
EQ_V36_SIM_TARGET_ATR_MULT=2.8
EQ_V36_SIM_INTRAMONTH_PORTFOLIO_STOP_PCT=0.08
EQ_V36_SIM_BE_TRIGGER_R=0.8
EQ_V36_SIM_TRAIL_ATR_MULT=1.5
EQ_V36_CURRENT_MIN_MOM_LOOKBACK_PCT=5.0
EQ_V36_CURRENT_STOP_ATR_MULT=2.0
EQ_V36_CURRENT_TARGET_ATR_MULT=2.8

EQ_V36_CURRENT_RELAXED_MIN_MOM_LOOKBACK_PCT=0.0
EQ_V36_CURRENT_RELAXED_PULLBACK_MIN_PCT=-20.0
EQ_V36_CURRENT_RELAXED_PULLBACK_MAX_PCT=1.0
EQ_V36_CURRENT_RELAXED_MAX_PAIR_CORR=0.90
EQ_V36_CURRENT_RELAXED_UNIVERSE_TOP_K=30

# ── Live risk management — tuned to match v38 sim (BE 0.8R + 1.5 ATR trail) ──
# For S&P500 universe avg ATR20 ≈ 2-3%.
# BE trigger 0.8R ≈ 0.8 × 2.0 ATR × 2.5% = ~4.0% gain → use 3.5% as threshold.
# Trail distance 1.5 ATR ≈ 1.5 × 2.5% = ~3.75% → use 3.5% from HWM.
# SL = 2.0 ATR ≈ 2.0 × 2.5% = ~5% from entry.
MONTHLY_TRAIL_ENABLE=1
MONTHLY_TRAIL_MIN_GAIN_PCT=3.5
MONTHLY_TRAIL_PCT=0.035
MONTHLY_SL_ENABLE=1
MONTHLY_SL_PCT=0.05
ALPACA_BROKER_PROTECTION_ENABLE=1
ALPACA_BROKER_PROTECTION_REQUIRED=1
ALPACA_BROKER_PROTECTION_ORDER_CLASS=simple_stop
ALPACA_BROKER_PROTECTION_SIZE_MODE=qty
ALPACA_BROKER_PROTECTION_TIF=day
ALPACA_NATIVE_TRAIL_ENABLE=1
ALPACA_NATIVE_TRAIL_REQUIRED=0
ALPACA_NATIVE_TRAIL_TIF=day
ALPACA_NATIVE_TRAIL_MIN_GAIN_PCT=3.5
ALPACA_NATIVE_TRAIL_PERCENT=3.5
ALPACA_NATIVE_TRAIL_CANCEL_EXISTING_STOPS=1
MONTHLY_REENTRY_BLOCK_ENABLE=1
MONTHLY_TRAIL_REENTRY_BLOCK_DAYS=21

ALPACA_DEEPSEEK_NOTE_ENABLE=1
ALPACA_DEEPSEEK_NOTE_MAX_CHARS=420
ALPACA_DEEPSEEK_ADVISORY_ENABLE=1
ALPACA_DEEPSEEK_ADVISORY_MAX_CHARS=520
ALPACA_DEEPSEEK_ADVISORY_PATH=runtime/equities_monthly_v36/latest_advisory.json
