## Regime overlay: bull_chop (NEW — 2026-05-03)
## Apply when orchestrator_state.json shows regime=bull_chop
##
## Was MISSING. While bear_chop/bear_trend/bull_trend overlays existed,
## bull_chop had no overlay → bot kept bear_chop config when regime flipped
## (or canary v2 with REGIME_OVERLAY_ENABLE=0 just sat with frozen flags).
##
## Activates: ASB1 (PRIMARY long), ATT1 (longs primary), IVB1 (research),
##            midterm pullback, ARF1 (shorts only at clean resistance)
## Deactivates: breakdown, pure-shorts of slope/range, all v7

## === BREAKOUT — moderate (chop limits trend room) ===
ENABLE_BREAKOUT_TRADING=1
BREAKOUT_ALLOW_LONGS=1
BREAKOUT_ALLOW_SHORTS=0
BREAKOUT_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT

## === BREAKDOWN — OFF in bull_chop ===
ENABLE_BREAKDOWN_TRADING=0

## === RESISTANCE FADE (ARF1) — SHORTS ONLY с tight filters ===
## В bull_chop fade может работать на временных перепродажах, но опасен.
## Жёсткие фильтры: высокий RSI, чистое отрицание, маленький time stop.
ENABLE_FLAT_TRADING=1
ARF1_ALLOW_LONGS=0
ARF1_ALLOW_SHORTS=1
ARF1_SYMBOL_ALLOWLIST=ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ARF1_MIN_RSI=68.0
ARF1_SL_ATR_MULT=0.55
ARF1_TIME_STOP_BARS_5M=288
ARF1_REJECT_BELOW_RES_ATR=0.10
ARF1_MAX_CLOSE_VS_EMA_PCT=0.9

## === SUPPORT BOUNCE (ASB1) — PRIMARY LONG в bull_chop ===
ENABLE_BOUNCE_TRADING=1
ASB1_ALLOW_LONGS=1
ASB1_ALLOW_SHORTS=0
ASB1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT
ASB1_MIN_RSI=30.0
ASB1_MAX_RSI=42.0
ASB1_SL_ATR_MULT=0.85
ASB1_TP1_FRAC=0.60

## === MIDTERM — pullback longs ON ===
ENABLE_MIDTERM_TRADING=1
MIDTERM_SYMBOLS=BTCUSDT,ETHUSDT

## === SLOPED — both sides ON, but tighter ===
ENABLE_SLOPED_TRADING=1
ASC1_ALLOW_LONGS=1
ASC1_ALLOW_SHORTS=1
ASC1_SYMBOL_ALLOWLIST=ADAUSDT,LINKUSDT,DOTUSDT,ATOMUSDT
ASC1_MIN_RANGE_R2=0.55
ASC1_LONG_MAX_NEG_SLOPE_PCT=0.05
ASC1_SHORT_MAX_POS_SLOPE_PCT=0.0
ASC1_CONFIRM_5M_BARS=5

## === RANGE SCALP — both sides moderate ===
ENABLE_RANGE_TRADING=1
ARS1_ALLOW_LONGS=1
ARS1_ALLOW_SHORTS=1
ARS1_SYMBOL_ALLOWLIST=ADAUSDT,LINKUSDT,DOTUSDT,LTCUSDT,SUIUSDT
ARS1_MIN_BAND_WIDTH_PCT=2.5
ARS1_RSI_LONG_MAX=32
ARS1_RSI_SHORT_MIN=68

## === ATT1 — longs primary, shorts ослаблены ===
## ATT1 уже включён глобально canary env'ом. Здесь параметры под bull_chop:
ATT1_RSI_LONG_MAX=55
ATT1_RSI_SHORT_MIN=42

## === IVB1 — research mode на bull-импульсах ===
ENABLE_IMPULSE_TRADING=1
IVB1_ALLOW_LONGS=1
IVB1_ALLOW_SHORTS=0
IVB1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT
## conservative params from r073 winner
IVB1_MIN_VOLUME_RATIO=2.5
IVB1_SL_ATR_MULT=1.4
IVB1_RR=2.5
IVB1_RSI_MIN=55

## === ELDER v2 — longs only в bull ===
ETS2_ALLOW_LONGS=1
ETS2_ALLOW_SHORTS=0

## === v7 sleeves — все OFF ===
ENABLE_BREAKDOWN2_TRADING=0
ENABLE_SLOPE_CHOCH_TRADING=0
ENABLE_LC_TRADING=0
ENABLE_FR_TRADING=0
ENABLE_MSCALP_TRADING=0

## Mild risk reduction in chop (vs bull_trend = 1.0)
RISK_MULT_OVERRIDE=0.85
