# Fail-safe approved crypto baseline — 2026-07-10
#
# The bot loads this file after .env with override=True. It must therefore be
# safe even when a server-only operator override is missing, stale, or fails to
# load. Only ATT1 short r001 may have positive base risk, capped at 0.10.
# Shadow scanners may remain enabled at risk_mult=0; no other sleeve can place
# money from this baseline alone.
#
# Geometry/side matches configs/att1_short_r001_canary_20260702.env. The
# positive risk here is a safety ceiling, not a claim that live edge is proven.

ALLOW_AUTO_APPLY_OVERRIDES=0
ALLOW_AUTO_APPLY_HOT_RELOAD=0
ALLOW_DYNAMIC_PARAM_HOT_RELOAD=0
REGIME_OVERLAY_ENABLE=0
PORTFOLIO_ALLOCATOR_ENABLE=0

NO_ENTRY_HOURS_UTC=
MAX_POSITIONS=3
ORCH_GLOBAL_RISK_MULT=0.55
ALLOCATOR_GLOBAL_RISK_MULT=0.80
MAX_OPEN_PORTFOLIO_RISK_PCT=1.50
MAX_SAME_DIRECTION_POSITIONS=2

ENABLE_ATT1_TRADING=1
ENABLE_FLAT_TRADING=0
ENABLE_BREAKDOWN_TRADING=0
ENABLE_MIDTERM_TRADING=1

ENABLE_BREAKOUT_TRADING=0
ENABLE_SLOPED_TRADING=0
ENABLE_RANGE_TRADING=0
ENABLE_BOUNCE_TRADING=0
ENABLE_BOUNCE1_TRADING=1
ENABLE_IMPULSE_TRADING=0
ENABLE_IVB1_TRADING=1
ENABLE_ELDER_TRADING=0
ENABLE_ELDER_V2_TRADING=0
ENABLE_ASM1_TRADING=0
ENABLE_ASB1_TRADING=0
ENABLE_HZBO1_TRADING=0
ENABLE_BRC1_TRADING=0

ATT1_RISK_MULT=0.10
ATT1_ALLOW_LONGS=0
ATT1_ALLOW_SHORTS=1
FLAT_RISK_MULT=0.00
BREAKDOWN_RISK_MULT=0.00
MIDTERM_RISK_MULT=0.00
BREAKOUT_RISK_MULT=0.00
SLOPED_RISK_MULT=0.00
RANGE_RISK_MULT=0.00
BOUNCE1_RISK_MULT=0.00
IVB1_RISK_MULT=0.00
ELDER_RISK_MULT=0.00
ELDER_V2_RISK_MULT=0.00
ASM1_RISK_MULT=0.00
ASB1_RISK_MULT=0.00
HZBO1_RISK_MULT=0.00
BRC1_RISK_MULT=0.00

ATT1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ATT1_PIVOT_LEFT=2
ATT1_PIVOT_RIGHT=3
ATT1_MIN_PIVOTS=2
ATT1_MAX_PIVOT_AGE=16
ATT1_MIN_R2=0.55
ATT1_TOUCH_ATR=0.5
ATT1_RSI_LONG_MAX=52
ATT1_RSI_SHORT_MIN=45

# 2026-06-27: BD1 quarantined. Server evidence:
# - breakdown_recent_bear_window_v2_entry_quality: 36/36 FAIL; best net=-8.47, PF=0.58, DD=8.73.
# - 2026-06-11 360d sweep best row still failed gates: net=+2.67, PF=1.079, DD=8.44, 5 red months.
# Keep the env block below only for reproducible backtests; live enable/risk stay zero until a deep rewrite passes gates.
BREAKDOWN_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT
BREAKDOWN_ALLOW_SHORTS=1
BREAKDOWN_ALLOW_FAILED_RECLAIM=1
BREAKDOWN_ALLOW_CONTINUATION=1
BREAKDOWN_REGIME_MODE=ema
BREAKDOWN_REGIME_MIN_ER=0.15
BREAKDOWN_REGIME_ER_BARS=20
BREAKDOWN_LOOKBACK_H=48
BREAKDOWN_RSI_MAX=55
BREAKDOWN_BUFFER_ATR=0.10
BREAKDOWN_MIN_BREAK_ATR=0.20
BREAKDOWN_IMPULSE_BODY_MIN_FRAC=0.35
BREAKDOWN_MAX_DIST_ATR=2.0
BREAKDOWN_SL_ATR=1.8
BREAKDOWN_RR=2.0
BREAKDOWN_TP1_FRAC=0.50
BREAKDOWN_MAX_RETEST_BARS=30
BREAKDOWN_TIME_STOP_BARS_5M=288
BREAKDOWN_COOLDOWN_BARS_5M=48

ARF1_SYMBOL_ALLOWLIST=ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ARF1_MIN_RSI=48
ARF1_SL_ATR_MULT=0.60
ARF1_TP1_FRAC=0.60
ARF1_TP2_BUFFER_PCT=0.45
ARF1_TRAIL_ATR_MULT=0.0
ARF1_TIME_STOP_BARS_5M=576
ARF1_REJECT_BELOW_RES_ATR=0.08
ARF1_RES_TOUCH_BUFFER_ATR=0.35
ARF1_MAX_CLOSE_VS_EMA_PCT=1.2

MIDTERM_SYMBOLS=BTCUSDT,ETHUSDT

# Prospective risk-zero lifecycle accepted on 2026-08-08.  The frozen exact
# replay passed only on BTC/ETH; the eight-symbol replay remains BLOCKED_DATA.
# Keep the strategy enabled at zero risk and collect decision/fill/exit parity
# without silently expanding to symbols selected after seeing results.
BOUNCE1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT
BOUNCE1_SHADOW_ENABLE=1
BOUNCE1_SL_ATR_MULT=1.6
BOUNCE1_TP1_FRAC=0.15
BOUNCE1_TRAIL_ATR_MULT=0.0
BOUNCE1_SHADOW_STATE_PATH=runtime/bounce1_shadow_state.json
BOUNCE1_SHADOW_LEDGER_PATH=runtime/bounce1_shadow_ledger.jsonl

PORTFOLIO_GLOBAL_SL_COOLDOWN_BARS=48
PORTFOLIO_GLOBAL_SL_STRATEGIES=alt_inplay_breakdown_v1
