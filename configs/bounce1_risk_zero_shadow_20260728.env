# BOUNCE1 support-bounce: evidence collection only.
# No real order can be submitted while BOUNCE1_RISK_MULT=0.0.
ENABLE_BOUNCE1_TRADING=1
BOUNCE1_RISK_MULT=0.0
BOUNCE1_SHADOW_ENABLE=1

# Use the full current liquid research surface. Do not remove a losing symbol
# after seeing its result; symbol contribution is part of the shadow verdict.
BOUNCE1_SYMBOL_ALLOWLIST=ADAUSDT,BTCUSDT,DOTUSDT,ETHUSDT,LINKUSDT,LTCUSDT,SOLUSDT,SUIUSDT
BOUNCE1_ALLOW_LONGS=1
BOUNCE1_ALLOW_SHORTS=0

# Claude plateau candidate, reproduced under the new isolated prefix.
BOUNCE1_SL_ATR_MULT=1.6
BOUNCE1_TP1_FRAC=0.15
BOUNCE1_TRAIL_ATR_MULT=0.0

# Persistent public-data lifecycle.
BOUNCE1_SHADOW_STATE_PATH=runtime/bounce1_shadow_state.json
BOUNCE1_SHADOW_LEDGER_PATH=runtime/bounce1_shadow_ledger.jsonl
