## Alpaca monthly v38 more-active research profile
## Created: 2026-04-28
##
## Goal:
## - test whether monthly v38 can be made more active for income
##
## Evidence from runtime/alpaca_income_sweep_20260428.csv:
## - full 2024-05..2026-04: +51.91%, annualized ~23.25%
## - PF 4.54, WR 78.0%, trades 41, max monthly DD -4.36%
## - active months 14/24, negative months 3/24
##
## Interpretation:
## - more active than base/hybrid, but lower quality than hybrid top4_t32
## - not a live promotion candidate yet; use only for further research

EQ_V36_TAG=equities_monthly_v38_more_active_research
EQ_V36_RUNTIME_DIR=runtime/equities_monthly_v38_more_active_research
ALPACA_AUTOPILOT_RUNTIME_DIR=runtime/equities_monthly_v38_more_active_research
EQ_V36_SIM_START_MONTH=2024-05
EQ_V36_SIM_END_MONTH=2026-04
EQ_V36_SIM_MAX_HOLD_DAYS=20
EQ_V36_SIM_MIN_MOM_LOOKBACK_PCT=0.0
EQ_V36_SIM_STOP_ATR_MULT=2.0
EQ_V36_SIM_TARGET_ATR_MULT=2.8
EQ_V36_SIM_INTRAMONTH_PORTFOLIO_STOP_PCT=0.08
EQ_V36_SIM_BE_TRIGGER_R=0.8
EQ_V36_SIM_TRAIL_ATR_MULT=1.5

EQ_V36_CURRENT_TOP_N=3
EQ_V36_CURRENT_UNIVERSE_TOP_K=14
EQ_V36_CURRENT_MIN_MOM_LOOKBACK_PCT=0.0
EQ_V36_CURRENT_PULLBACK_MIN_PCT=-12.0
EQ_V36_CURRENT_PULLBACK_MAX_PCT=-1.5

## These regime thresholds are intentionally looser than base v38.
## They increased active months, but also increased drawdown and red months.
EQ_V36_SIM_REGIME_MIN_BREADTH_SMA_PCT=45
EQ_V36_SIM_REGIME_MIN_BREADTH_MOM_PCT=45
EQ_V36_SIM_REGIME_MIN_AVG_MOM_PCT=0.0
