{
  "name": "ivb1_short_wider_bounded_20260627",
  "description": "Bounded overnight IVB1 short-only wider-universe check. Builds on the positive IVB1 short recheck but asks whether the edge survives more symbols and stricter entry-distance guards.",
  "cache_only": true,
  "timeout_sec": 900,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "{SYMBOLS}",
    "--strategies",
    "impulse_volume_breakout_v1",
    "--days",
    "240",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "2",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2",
    "--entry-on-next-open"
  ],
  "base_env": {
    "BACKTEST_CACHE_ONLY": "1",
    "IVB1_DIRECTION_MODE": "short_only",
    "IVB1_REGIME_MODE": "off",
    "IVB1_MACRO_REQUIRE_BULL": "0",
    "IVB1_BREAKOUT_LOOKBACK_BARS": "24",
    "IVB1_IMPULSE_LOOKBACK_BARS": "18",
    "IVB1_VOL_PERIOD": "20",
    "IVB1_MIN_IMPULSE_PCT": "0.045",
    "IVB1_MIN_BAR_RANGE_ATR": "1.2",
    "IVB1_BREAKOUT_BUFFER_ATR": "0.0",
    "IVB1_RETRACE_MIN_FRAC": "0.10",
    "IVB1_RECLAIM_ATR": "0.08",
    "IVB1_ENTRY_BODY_MIN_FRAC": "0.25",
    "IVB1_TOUCH_BELOW_BREAKOUT_ATR": "0.20",
    "IVB1_INVALIDATION_CLOSE_ATR": "0.35",
    "IVB1_TP1_RR": "0.9",
    "IVB1_TRAIL_ATR_MULT": "1.4",
    "IVB1_TRAIL_ACTIVATE_RR": "0.9",
    "IVB1_TIME_STOP_BARS_5M": "72",
    "IVB1_COOLDOWN_BARS_5M": "12",
    "IVB1_MIN_RR": "1.5"
  },
  "grid": {
    "SYMBOLS": [
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,DOGEUSDT,ADAUSDT",
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,DOGEUSDT,ADAUSDT,LTCUSDT,XRPUSDT"
    ],
    "IVB1_MIN_VOL_MULT": ["1.2", "1.35"],
    "IVB1_RETRACE_MAX_FRAC": ["0.35", "0.45"],
    "IVB1_SL_ATR": ["0.75", "0.90"],
    "IVB1_MAX_ENTRY_DIST_ATR": ["1.4", "2.0"]
  },
  "constraints": {
    "min_trades": 20,
    "min_profit_factor": 1.20,
    "max_drawdown": 8.0,
    "min_net_pnl": 2.0,
    "max_negative_months": 4,
    "max_negative_streak": 2,
    "min_winrate": 0.42
  },
  "score_weights": {
    "net_pnl": 1.2,
    "profit_factor": 6.0,
    "winrate": 4.0,
    "max_drawdown": 2.5,
    "trades": 0.08,
    "trades_cap": 160,
    "negative_months": 2.5,
    "max_negative_streak": 2.5,
    "worst_month_pnl": 1.5
  },
  "_combo_count": "2 baskets x 2 vol x 2 retrace x 2 SL x 2 entry-distance = 32 combinations"
}
