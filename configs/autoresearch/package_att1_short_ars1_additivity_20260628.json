{
  "name": "package_att1_short_ars1_additivity_20260628",
  "description": "Bounded package test: ATT1 trendline-touch first, ARS1 range scalp second. Answers whether the frequent range/pila sleeve diversifies the strong ATT1 short-biased candidate or worsens DD/monthly stability. Research-only; no live unpause.",
  "cache_only": true,
  "timeout_sec": 1200,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "{SYMBOLS}",
    "--strategies",
    "alt_trendline_touch_v1,alt_range_scalp_v1",
    "--days",
    "360",
    "--end",
    "2026-04-30",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.006",
    "--leverage",
    "1",
    "--max_positions",
    "4",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2",
    "--entry-on-next-open"
  ],
  "base_env": {
    "BACKTEST_CACHE_ONLY": "1",
    "ATT1_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT",
    "ATT1_PIVOT_LEFT": "2",
    "ATT1_PIVOT_RIGHT": "3",
    "ATT1_MIN_PIVOTS": "2",
    "ATT1_MAX_PIVOT_AGE": "24",
    "ATT1_MIN_R2": "0.55",
    "ATT1_TOUCH_ATR": "0.50",
    "ATT1_RSI_LONG_MAX": "52",
    "ATT1_ALLOW_LONGS": "0",
    "ATT1_ALLOW_SHORTS": "1",
    "ATT1_SL_ATR_MULT": "1.10",
    "ATT1_TP1_RR": "1.20",
    "ATT1_TP2_RR": "2.50",
    "ATT1_TP1_FRAC": "0.55",
    "ATT1_BE_TRIGGER_RR": "1.00",
    "ATT1_TRAIL_ATR_MULT": "1.50",
    "ATT1_MIN_RR": "1.15",
    "ARS1_SYMBOL_ALLOWLIST": "ADAUSDT,LINKUSDT,DOTUSDT,LTCUSDT,SUIUSDT,ATOMUSDT,SOLUSDT",
    "ARS1_BB_PERIOD": "20",
    "ARS1_BB_STD": "2.0",
    "ARS1_MIN_BAND_WIDTH_PCT": "1.5",
    "ARS1_MAX_BAND_WIDTH_PCT": "24.0",
    "ARS1_RSI_LONG_MAX": "38",
    "ARS1_RSI_SHORT_MIN": "55",
    "ARS1_SL_ATR_MULT": "0.8",
    "ARS1_TP1_FRAC": "0.55",
    "ARS1_MIN_RR": "1.15",
    "ARS1_MIN_STOP_PCT": "0.0015",
    "ARS1_MAX_STOP_PCT": "0.0600",
    "ARS1_TIME_STOP_BARS_5M": "216",
    "ARS1_COOLDOWN_BARS_5M": "12",
    "ARS1_ADX_PERIOD": "14",
    "ARS1_ALLOW_SHORTS": "1",
    "ARS1_TRAIL_ACTIVATE_RR": "1.0"
  },
  "grid": {
    "SYMBOLS": [
      "BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT",
      "BTCUSDT,SOLUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT"
    ],
    "ATT1_RISK_MULT": ["0.55", "0.70"],
    "RANGE_RISK_MULT": ["0.00", "0.20", "0.35"],
    "ARS1_ALLOW_LONGS": ["0", "1"],
    "ARS1_MAX_ADX": ["18.0", "24.0"],
    "ARS1_RECLAIM_ATR": ["0.0", "0.15"],
    "ARS1_TRAIL_ATR_MULT": ["0.0", "1.5"]
  },
  "constraints": {
    "min_trades": 100,
    "min_profit_factor": 1.28,
    "max_drawdown": 7.0,
    "min_net_pnl": 18.0,
    "max_negative_months": 3,
    "max_negative_streak": 2,
    "min_winrate": 0.45
  },
  "score_weights": {
    "net_pnl": 1.4,
    "profit_factor": 6.0,
    "winrate": 4.0,
    "max_drawdown": 3.0,
    "trades": 0.10,
    "trades_cap": 420,
    "negative_months": 3.0,
    "max_negative_streak": 3.0,
    "worst_month_pnl": 2.0
  },
  "_notes": {
    "priority": "ATT1 is listed first in --strategies so ARS1 cannot override a same-bar trendline setup.",
    "baseline": "RANGE_RISK_MULT=0.00 rows are ATT1-only controls; ARS1 rows must beat or materially smooth this baseline to be useful.",
    "combo_count": "2 symbol baskets x 2 ATT1 risk x 3 ARS1 risk x 2 ARS1 long gate x 2 ADX x 2 reclaim x 2 trail = 192 combos"
  }
}
