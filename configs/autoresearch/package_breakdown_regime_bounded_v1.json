{
  "name": "package_breakdown_regime_bounded_v1",
  "description": "Bounded diagnostic replay for current live blocker breakdown_ns_regime. Tests whether relaxing BREAKDOWN_REGIME_MIN_ER restores entries without destroying package quality. Research-only: do not auto-apply to live.",
  "cache_only": false,
  "timeout_sec": 2400,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT",
