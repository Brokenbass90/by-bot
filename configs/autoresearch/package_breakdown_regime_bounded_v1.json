    "--end",
    "2026-06-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.01",
    "--leverage",
    "1",
    "--max_positions",
    "5",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
