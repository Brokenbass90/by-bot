{
  "name": "arf1_filter_v1",
  "description": "ARF1 filter sweep. Live blockers (blocker report 2026-05-21): no_res_touch и no_reject_back. Sweeps resistance_touch_buffer_atr, reject_below_res_atr, min_rsi, and the new ARF1_REJECT_REQUIRE_LOWER_CLOSE flag added in the 2026-05-25 patch.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "LINKUSDT,LTCUSDT,SUIUSDT,DOTUSDT,ADAUSDT,BCHUSDT",
    "--strategies",
    "alt_resistance_fade_v1",
    "--days",
    "360",
    "--end",
    "2026-04-30",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.0075",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "ARF1_SYMBOL_ALLOWLIST": "LINKUSDT,LTCUSDT,SUIUSDT,DOTUSDT,ADAUSDT,BCHUSDT",
    "ARF1_SIGNAL_LOOKBACK": "48",
    "ARF1_SIGNAL_EMA_PERIOD": "20",
    "ARF1_SL_ATR_MULT": "0.85",
    "ARF1_TP1_FRAC": "0.60",
    "ARF1_COOLDOWN_BARS_5M": "48"
  },
  "grid": {
    "ARF1_RES_TOUCH_BUFFER_ATR": [0.25, 0.35, 0.45, 0.55],
    "ARF1_REJECT_BELOW_RES_ATR": [0.06, 0.09, 0.12, 0.16],
    "ARF1_MIN_RSI": [52, 55, 58, 62],
    "ARF1_REJECT_REQUIRE_LOWER_CLOSE": ["0", "1"]
  },
  "constraints": {
    "min_trades": 30,
    "min_profit_factor": 1.15,
    "max_drawdown": 12.0,
    "min_net_pnl": 3.0,
    "max_negative_months": 5,
    "max_negative_streak": 3
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 5.5,
    "winrate": 5.0,
    "max_drawdown": 2.0,
    "trades": 0.16,
    "trades_cap": 200,
    "negative_months": 2.0,
    "worst_month_pnl": 1.5
  },
  "_notes": {
    "blocker_source": "runtime/crypto_blocker/latest.md 2026-05-21",
    "new_param": "ARF1_REJECT_REQUIRE_LOWER_CLOSE: '0'=only bearish bar required (looser); '1'=also require close<prev_close (current live default)",
    "hypothesis": "resistance_touch_buffer_atr=0.35 misses touches 0.35-0.55 ATR away. reject_below_res_atr=0.12 forces close very far below res; loosening to 0.06-0.09 should confirm more rejections if RSI guards hold.",
    "combo_count": "4x4x4x2 = 128 combos, ~30 min on server"
  },
  "_combo_count": "4x4x4x2 = 128 combos"
}
