{
  "name": "arf1_filter_v1",
  "description": "Bounded ARF1 filter replay for the observed live no_res_touch/no_reject_back blockers. Uses only existing strategy parameters and stays research-only until a full crypto_income_static_v1 package replay improves the baseline.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "LINKUSDT,LTCUSDT,SUIUSDT,DOTUSDT,ADAUSDT,BCHUSDT",
    "--strategies",
    "alt_resistance_fade_v1",
    "--days",
    "360",
    "--end",
    "2026-04-30",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.0075",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "ARF1_SYMBOL_ALLOWLIST": "LINKUSDT,LTCUSDT,SUIUSDT,DOTUSDT,ADAUSDT,BCHUSDT",
    "ARF1_SIGNAL_TF": "60",
    "ARF1_SIGNAL_LOOKBACK": "60",
    "ARF1_REGIME_MAX_GAP_PCT": "3.2",
    "ARF1_REGIME_MAX_SLOPE_PCT": "1.8",
    "ARF1_MIN_RANGE_PCT": "6.0",
    "ARF1_MAX_RANGE_PCT": "30.0",
    "ARF1_MIN_BODY_FRAC": "0.22",
    "ARF1_MAX_CLOSE_VS_EMA_PCT": "1.2",
    "ARF1_TP1_FRAC": "0.60",
    "ARF1_TP2_BUFFER_PCT": "0.45",
    "ARF1_SL_ATR_MULT": "0.85",
    "ARF1_TIME_STOP_BARS_5M": "576"
  },
  "grid": {
    "ARF1_RES_TOUCH_BUFFER_ATR": [0.25, 0.35, 0.45, 0.55],
    "ARF1_REJECT_BELOW_RES_ATR": [0.06, 0.09, 0.12],
    "ARF1_MIN_RSI": [55, 58, 62]
  },
  "constraints": {
    "min_trades": 30,
    "min_profit_factor": 1.25,
    "max_drawdown": 8.0,
    "min_net_pnl": 6.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.0,
    "profit_factor": 4.0,
    "winrate": 7.0,
    "max_drawdown": 2.0,
    "trades": 0.12,
    "trades_cap": 120,
    "negative_months": 2.5,
    "max_negative_streak": 3.0,
    "worst_month_pnl": 1.5
  },
  "_combo_count": "4x3x3 = 36 combos",
  "_promotion_rule": "Standalone PASS is insufficient; rerun the winner inside crypto_income_static_v1 and require package improvement before live."
}
