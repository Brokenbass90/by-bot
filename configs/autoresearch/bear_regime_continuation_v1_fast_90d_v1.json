{
  "name": "bear_regime_continuation_v1_fast_90d_v1",
  "description": "Fast recent-market sweep for BRC1 short continuation. Focuses on current weak/choppy crypto where live core is not getting paid.",
  "cache_only": true,
  "timeout_sec": 600,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "SOLUSDT,ADAUSDT,DOTUSDT,LINKUSDT,SUIUSDT,LTCUSDT",
    "--strategies",
    "alt_bear_regime_continuation_v1",
    "--days",
    "90",
    "--end",
    "2026-04-30",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.0075",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {},
  "grid": {
    "BRC1_PULLBACK_BARS": [3, 4],
    "BRC1_PULLBACK_MIN_PCT": [0.25, 0.4],
    "BRC1_RSI_MIN": [45, 50],
    "BRC1_RSI_MAX": [62, 68],
    "BRC1_MIN_REJECT_WICK_RATIO": [0.8, 1.2],
    "BRC1_RR": [1.3, 1.6]
  },
  "constraints": {
    "min_trades": 10,
    "min_profit_factor": 1.15,
    "max_drawdown": 6.0,
    "min_net_pnl": 1.0,
    "max_negative_months": 2,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.4,
    "profit_factor": 5.0,
    "winrate": 4.5,
    "max_drawdown": 2.0,
    "trades": 0.12,
    "trades_cap": 120,
    "negative_months": 1.5,
    "worst_month_pnl": 1.2
  }
}
