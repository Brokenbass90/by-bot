{
  "name": "pfs1_solo_24h_bounded_v1",
  "description": "Memory-safe 24h standalone PFS1 check for the live VPS. This replaces the heavy package PFS1 run on 1GB hosts; package additivity must run on a research box.",
  "cache_only": true,
  "timeout_sec": 900,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,SUIUSDT",
    "--strategies",
    "pump_fade_smart_v1",
    "--days",
    "180",
    "--end",
    "2026-04-25",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "2",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2",
    "--entry-on-next-open"
  ],
  "base_env": {
    "BACKTEST_CACHE_ONLY": "1",
    "PFS1_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,SUIUSDT",
    "PFS1_ALLOW_SHORTS": "1",
    "PFS1_ALLOW_LONGS": "0",
    "PFS1_REQUIRE_FUNDING_DATA": "0",
    "PFS1_REJECT_BODY_FRAC": "0.45",
    "PFS1_REJECT_WICK_FRAC": "0.35",
    "PFS1_SL_ATR_BUFFER": "0.5",
    "PFS1_TP1_RR": "1.2",
    "PFS1_TP2_RR": "2.5",
    "PFS1_TP1_FRAC": "0.55",
    "PFS1_MIN_STOP_PCT": "0.002",
    "PFS1_MAX_STOP_PCT": "0.080",
    "PFS1_COOLDOWN_BARS_5M": "96"
  },
  "grid": {
    "PFS1_PUMP_MIN_PCT": [2.5, 3.0],
    "PFS1_VOL_Z_MIN": [1.5, 2.0],
    "PFS1_RSI_H1_MIN_OB": [65, 70],
    "PFS1_MAX_DIST_ATR": [1.2, 1.5]
  },
  "constraints": {
    "min_trades": 6,
    "min_profit_factor": 1.15,
    "max_drawdown": 8.0,
    "min_net_pnl": 0.0,
    "max_negative_months": 2,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.4,
    "profit_factor": 5.0,
    "winrate": 4.0,
    "max_drawdown": 2.0,
    "trades": 0.12,
    "trades_cap": 60,
    "negative_months": 2.0,
    "worst_month_pnl": 1.2
  },
  "_combo_count": "2x2x2x2 = 16 lightweight standalone combinations",
  "_caveat": "Funding disabled for this VPS-safe first pass. Any GO must be re-run with historical funding on a research host before shadow."
}
