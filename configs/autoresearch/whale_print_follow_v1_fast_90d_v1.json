{
  "name": "whale_print_follow_v1_fast_90d_v1",
  "description": "Fast recent-market sweep for WHALE bar-print following. Searches event-style movement in otherwise quiet crypto.",
  "cache_only": true,
  "timeout_sec": 600,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT,LTCUSDT,SUIUSDT",
    "--strategies",
    "alt_whale_print_follow_v1",
    "--days",
    "90",
    "--end",
    "2026-04-30",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.0075",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "WHALE_ALLOW_LONGS": "1",
    "WHALE_ALLOW_SHORTS": "1",
    "WHALE_REGIME_MODE": "all",
    "WHALE_TIME_STOP_BARS_5M": "90"
  },
  "grid": {
    "WHALE_VOL_SPIKE_MULT": [2.0, 2.5, 3.0],
    "WHALE_MIN_RANGE_ATR": [1.0, 1.3],
    "WHALE_MIN_BODY_FRAC": [0.40, 0.50],
    "WHALE_CLOSE_POS_THRESHOLD": [0.65, 0.75],
    "WHALE_RR": [1.2, 1.5],
    "WHALE_REQUIRE_DOMINANT_VOL": [0, 1]
  },
  "constraints": {
    "min_trades": 12,
    "min_profit_factor": 1.15,
    "max_drawdown": 6.0,
    "min_net_pnl": 1.0,
    "max_negative_months": 2,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.4,
    "profit_factor": 5.0,
    "winrate": 4.0,
    "max_drawdown": 2.0,
    "trades": 0.12,
    "trades_cap": 120,
    "negative_months": 1.5,
    "worst_month_pnl": 1.2
  }
}
