{
  "name": "inplay_dd_repair_20260627",
  "description": "DD-repair sweep for InPlay Retest V3. Uses drawdown-doctor findings: shorts outperform longs, NEAR/SUI hurt the max-DD window, winners often continue after TP, many losses are SL. Tests short-only, symbol gating, wider stop buffer and runner.",
  "cache_only": true,
  "timeout_sec": 900,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "{SYMBOLS}",
    "--strategies",
    "inplay_retest_v3",
    "--days",
    "240",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "2",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2",
    "--entry-on-next-open"
  ],
  "base_env": {
    "BACKTEST_CACHE_ONLY": "1",
    "IRV3_USE_REGIME": "0",
    "IRV3_USE_SLOPED": "1",
    "IRV3_STRUCTURE_TF": "60",
    "IRV3_ENTRY_TF": "15",
    "IRV3_LEVEL_LOOKBACK": "240",
    "IRV3_ENTRY_LOOKBACK": "96",
    "IRV3_MIN_TOUCHES": "3",
    "IRV3_LEVEL_TOL_ATR": "0.35",
    "IRV3_RETEST_BAND_ATR": "0.45",
    "IRV3_REJECT_FRAC": "0.50",
    "IRV3_VOL_MULT": "0.0",
    "IRV3_MIN_RR_TP1": "1.15",
    "IRV3_TP1_FRAC": "0.60",
    "IRV3_MIN_STOP_PCT": "0.0015",
    "IRV3_MAX_STOP_PCT": "0.0600",
    "IRV3_BE_TRIGGER_RR": "1.0",
    "IRV3_COOLDOWN_BARS": "3",
    "IRV3_ALLOW_SHORT": "1"
  },
  "grid": {
    "SYMBOLS": [
      "ADAUSDT,DOGEUSDT",
      "ADAUSDT,DOGEUSDT,SUIUSDT",
      "ADAUSDT,DOGEUSDT,NEARUSDT,SUIUSDT"
    ],
    "IRV3_ALLOW_LONG": ["0", "1"],
    "IRV3_STOP_BUFFER_ATR": ["0.35", "0.55"],
    "IRV3_RR_RUNNER": ["3.0", "4.0"]
  },
  "constraints": {
    "min_trades": 15,
    "min_profit_factor": 1.15,
    "max_drawdown": 6.0,
    "min_net_pnl": 2.0,
    "max_negative_months": 2,
    "max_negative_streak": 2,
    "min_winrate": 0.38
  },
  "score_weights": {
    "net_pnl": 1.2,
    "profit_factor": 6.0,
    "winrate": 3.0,
    "max_drawdown": 2.5,
    "trades": 0.10,
    "trades_cap": 120,
    "negative_months": 3.0,
    "max_negative_streak": 2.5,
    "worst_month_pnl": 2.0
  },
  "_combo_count": "3 baskets x 2 long-gate x 2 stop-buffer x 2 runner = 24 combinations"
}
