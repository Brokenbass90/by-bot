  "_notes": {
    "why": "Live ATT1 has att1_try>0 but dominant blocker is att1_ns_trendline. Density research suggested R2=0.55 and pivot_age=24; this tests additivity inside the current package.",
    "acceptance_for_next_step": "If winner has PF >= 1.35, DD <= 7%, and trade count improves package cadence, run 365d promotion replay before live.",
    "combo_count": "3x3x2x2x2 = 72 combos"
  }
