    "min_trades": 60,
    "min_profit_factor": 1.2,
    "max_drawdown": 9.0,
    "min_net_pnl": 0.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 5.0,
    "winrate": 4.5,
    "max_drawdown": 2.2,
    "trades": 0.14,
    "trades_cap": 300,
    "negative_months": 2.0,
    "max_negative_streak": 1.5,
    "worst_month_pnl": 1.5
