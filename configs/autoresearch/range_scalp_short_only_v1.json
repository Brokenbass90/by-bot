{
  "name": "range_scalp_short_only_v1",
  "description": "Pair-1 split (SHORT-only) for alt_range_scalp_v1. Companion to range_scalp_long_only_v1.json. Goal: isolate which side carries the standalone +18.89 / PF 1.849 edge — and which side ruins additivity vs canary v2. SHORT-only run with broader RSI grid to find best short params separately.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "ADAUSDT,LINKUSDT,DOTUSDT,LTCUSDT,SUIUSDT,ATOMUSDT",
    "--strategies",
    "alt_range_scalp_v1",
    "--days",
    "360",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "{MAX_POSITIONS}",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "ARS1_ALLOW_LONGS": "0",
    "ARS1_ALLOW_SHORTS": "1",
    "ARS1_BB_PERIOD": "20",
    "ARS1_BB_STD": "2.0",
    "ARS1_SL_ATR_MULT": "0.8",
    "ARS1_TP1_FRAC": "0.55",
    "ARS1_TIME_STOP_BARS_5M": "216",
    "ARS1_COOLDOWN_BARS_5M": "48",
    "ARS1_SYMBOL_ALLOWLIST": "ADAUSDT,LINKUSDT,DOTUSDT,LTCUSDT,SUIUSDT,ATOMUSDT",
    "ARS1_MAX_BAND_WIDTH_PCT": "20.0"
  },
  "grid": {
    "ARS1_MIN_BAND_WIDTH_PCT": [2.5, 3.0, 4.0, 5.0],
    "ARS1_RSI_SHORT_MIN": [60, 62, 65, 68, 70, 72],
    "ARS1_SL_ATR_MULT": [0.7, 0.8, 1.0],
    "MAX_POSITIONS": [3, 4]
  },
  "constraints": {
    "min_trades": 35,
    "min_profit_factor": 1.20,
    "max_drawdown": 10.0,
    "min_net_pnl": 4.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.2,
    "profit_factor": 6.0,
    "winrate": 5.0,
    "max_drawdown": 1.8,
    "trades": 0.12,
    "trades_cap": 220,
    "negative_months": 2.0,
    "worst_month_pnl": 1.4
  },
  "_combo_count": "4x6x3x2 = 144 combos",
  "_goal": "Find best SHORT-only params for range_scalp on annual window. Then run paired additivity vs canary v2 (shorts only). If SHORT-only carries edge — promote to canary as range_scalp_shorts_only sleeve. Most likely outcome (hypothesis): SHORT-only edge stronger in current bear-dominated regime.",
  "_pair": "range_scalp_long_only_v1.json"
}
