{
  "name": "liquidity_sweep_reversal_v2_full_grid_v1",
  "description": "Sweep params для alt_liquidity_sweep_reversal_v2 (Claude-улучшенная версия v1 с per-symbol cooldown, regime gate, partial TP, panic mode, pool persistence). Цель — найти params где edge >= +5 net на 360d с PF>=1.20.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT,LTCUSDT,SUIUSDT",
    "--strategies",
    "alt_liquidity_sweep_reversal_v2",
    "--days",
    "360",
    "--end",
    "2026-04-30",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.0075",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "LQH2_ALLOW_LONGS": "1",
    "LQH2_ALLOW_SHORTS": "1",
    "LQH2_REGIME_MODE": "chop_only",
    "LQH2_RR": "2.0",
    "LQH2_TP1_RR": "1.0",
    "LQH2_TP1_FRAC": "0.50",
    "LQH2_BREAKEVEN_AFTER_TP1": "1",
    "LQH2_TRAIL_ATR_MULT": "1.0",
    "LQH2_TIME_STOP_BARS": "144",
    "LQH2_VOL_MODE": "quote",
    "LQH2_POOL_COOLDOWN_BARS_5M": "72",
    "LQH2_MAX_ADX": "25"
  },
  "grid": {
    "LQH2_LOOKBACK_BARS": [24, 36, 48],
    "LQH2_MIN_POOL_TOUCHES": [3, 4],
    "LQH2_POOL_PERSISTENCE_BARS": [4, 8, 12],
    "LQH2_MIN_POOL_WIDTH_ATR": [1.0, 1.5],
    "LQH2_MIN_SWEEP_ATR": [0.10, 0.20],
    "LQH2_MAX_SWEEP_ATR": [1.0, 1.5],
    "LQH2_MIN_VOL_MULT": [1.5, 2.0],
    "LQH2_ADX_PERIOD": [14]
  },
  "constraints": {
    "min_trades": 30,
    "min_profit_factor": 1.20,
    "max_drawdown": 10.0,
    "min_net_pnl": 5.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 6.0,
    "winrate": 4.5,
    "max_drawdown": 2.0,
    "trades": 0.14,
    "trades_cap": 200,
    "negative_months": 1.8,
    "worst_month_pnl": 1.4
  },
  "_combo_count": "3x2x3x2x2x2x2x1 = 288 combos",
  "_companion_panic": "Дополнительный sweep с LQH2_PANIC_MODE=1 — отдельный config если этот пройдёт"
}
