{
  "name": "pump_fade_v5_bear_window_v1",
  "description": "Pump-fade на bear-window. Прошлый прогон pump_fade_v4r дал PF=0.0 на 1 trade — likely params dead. Этот sweep делает relaxed pump-fade с акцентом на bear-направление и рост частоты.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "ADAUSDT,LINKUSDT,SUIUSDT,DOTUSDT,SOLUSDT,LTCUSDT",
    "--strategies",
    "pump_fade_v2",
    "--days",
    "360",
    "--end",
    "2026-04-30",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.0075",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2",
    "--entry-on-next-open"
  ],
  "base_env": {
    "PF2_ALLOW_LONGS": "0",
    "PF2_ALLOW_SHORTS": "1"
  },
  "grid": {
    "PF2_PUMP_THRESHOLD_PCT": [3.0, 5.0, 7.0],
    "PF2_LOOKBACK_BARS": [12, 24, 36],
    "PF2_VOLUME_MULT_MIN": [1.5, 2.0, 3.0],
    "PF2_RSI_THRESHOLD": [70, 75, 80],
    "PF2_SL_ATR_MULT": [0.7, 1.0, 1.3]
  },
  "constraints": {
    "min_trades": 30,
    "min_profit_factor": 1.20,
    "max_drawdown": 10.0,
    "min_net_pnl": 4.0
  },
  "score_weights": {
    "net_pnl": 1.2,
    "profit_factor": 6.0,
    "winrate": 4.5,
    "max_drawdown": 2.0,
    "trades": 0.14,
    "trades_cap": 150,
    "negative_months": 1.8,
    "worst_month_pnl": 1.4
  },
  "_combo_count": "3x3x3x3x3 = 243 combos"
}
