{
  "name": "ivb1_impulse_retrace_v2_relaxed_mirror",
  "description": "Relaxed + mirrored sweep for IVB1 ('impulse breakout with pullback'). Tests the review hypothesis that v1 is too conservative and too long-only: lower impulse/volume/body thresholds, wider retrace, longer wait, and separate long/short/both direction sets.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "{SYMBOLS}",
    "--strategies",
    "impulse_volume_breakout_v1",
    "--days",
    "360",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.006",
    "--leverage",
    "1",
    "--max_positions",
    "4",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "IVB1_REGIME_MODE": "off",
    "IVB1_MACRO_REQUIRE_BULL": "0",
    "IVB1_SL_ATR": "0.8",
    "IVB1_TP1_RR": "1.0",
    "IVB1_BE_TRIGGER_RR": "1.0",
    "IVB1_BE_LOCK_RR": "0.05",
    "IVB1_TIME_STOP_BARS_5M": "72",
    "IVB1_MIN_BAR_RANGE_ATR": "0.8",
    "IVB1_RETRACE_MIN_FRAC": "0.10",
    "IVB1_RECLAIM_ATR": "0.04",
    "IVB1_COOLDOWN_BARS_5M": "8",
    "IVB1_SYMBOL_ALLOWLIST": ""
  },
  "grid": {
    "SYMBOLS": [
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT",
      "DOGEUSDT,LINKUSDT,SOLUSDT,ADAUSDT",
      "NEARUSDT,SUIUSDT,ADAUSDT,LTCUSDT",
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,DOGEUSDT,ADAUSDT"
    ],
    "IVB1_DIRECTION_MODE": ["long", "short", "both"],
    "IVB1_MIN_IMPULSE_PCT": [0.025, 0.035],
    "IVB1_MIN_VOL_MULT": [1.20, 1.40],
    "IVB1_MIN_BODY_FRAC": [0.25, 0.35],
    "IVB1_RETRACE_MAX_FRAC": [0.55, 0.75],
    "IVB1_ENTRY_BODY_MIN_FRAC": [0.10, 0.20],
    "IVB1_MAX_WAIT_BARS_5M": [8, 16],
    "IVB1_RR": [1.6, 2.2]
  },
  "constraints": {
    "min_trades": 60,
    "min_profit_factor": 1.20,
    "max_drawdown": 8.0,
    "min_net_pnl": 5.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 5.5,
    "winrate": 4.0,
    "max_drawdown": 2.0,
    "trades": 0.14,
    "trades_cap": 220,
    "negative_months": 2.0,
    "worst_month_pnl": 1.4
  },
  "_combo_count": "4x3x2x2x2x2x2x2x2 = 1536 combos",
  "_goal": "Find whether IVB1's edge becomes tradable when frequency is raised and short mirror is allowed; split winners into long-only and short-only follow-up specs."
}
