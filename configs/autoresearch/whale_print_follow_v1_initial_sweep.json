{
  "name": "whale_print_follow_v1_initial_sweep",
  "description": "Whale Print Follow v1: следование за крупными игроками через volume+range+body+close_pos pattern. Особенно полезно в мёртвом рынке когда trend-стратегии не работают. Цель: PF≥1.25 на 360d, 30+ trades.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT,LTCUSDT,SUIUSDT",
    "--strategies",
    "alt_whale_print_follow_v1",
    "--days",
    "360",
    "--end",
    "2026-04-30",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.0075",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "WHALE_ALLOW_LONGS": "1",
    "WHALE_ALLOW_SHORTS": "1",
    "WHALE_REGIME_MODE": "all",
    "WHALE_REQUIRE_DOMINANT_VOL": "1",
    "WHALE_TIME_STOP_BARS_5M": "90"
  },
  "grid": {
    "WHALE_VOL_SPIKE_MULT": [2.5, 3.0, 4.0],
    "WHALE_MIN_RANGE_ATR": [1.2, 1.5, 2.0],
    "WHALE_MIN_BODY_FRAC": [0.45, 0.55, 0.65],
    "WHALE_CLOSE_POS_THRESHOLD": [0.70, 0.75, 0.80],
    "WHALE_RR": [1.3, 1.5, 1.8],
    "WHALE_SL_PAD_ATR": [0.15, 0.25]
  },
  "constraints": {
    "min_trades": 30,
    "min_profit_factor": 1.20,
    "max_drawdown": 9.0,
    "min_net_pnl": 5.0,
    "max_negative_months": 3,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 6.0,
    "winrate": 4.5,
    "max_drawdown": 2.0,
    "trades": 0.14,
    "trades_cap": 200,
    "negative_months": 1.8,
    "worst_month_pnl": 1.5
  },
  "_combo_count": "3x3x3x3x3x2 = 486 combos"
}
