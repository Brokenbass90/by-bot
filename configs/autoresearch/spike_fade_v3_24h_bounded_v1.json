{
  "name": "spike_fade_v3_24h_bounded_v1",
  "description": "24h bounded validation of SpikeFadeV3 after switching stop geometry to entry ATR. Tests pump-fade and dump-reclaim only at real clustered levels.",
  "cache_only": true,
  "timeout_sec": 900,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT,LTCUSDT,SUIUSDT",
    "--strategies",
    "spike_fade_v3",
    "--days",
    "240",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2",
    "--entry-on-next-open"
  ],
  "base_env": {
    "BACKTEST_CACHE_ONLY": "1",
    "SFV3_STRUCTURE_TF": "60",
    "SFV3_ENTRY_TF": "15",
    "SFV3_LEVEL_LOOKBACK": "240",
    "SFV3_ENTRY_LOOKBACK": "96",
    "SFV3_MIN_TOUCHES": "2",
    "SFV3_ALLOW_LONG": "1",
    "SFV3_ALLOW_SHORT": "1",
    "SFV3_MIN_STOP_PCT": "0.0015",
    "SFV3_MAX_STOP_PCT": "0.080",
    "SFV3_BE_TRIGGER_RR": "1.0",
    "SFV3_COOLDOWN_BARS": "3"
  },
  "grid": {
    "SFV3_LEVEL_TOL_ATR": [0.35, 0.50],
    "SFV3_SPIKE_MIN_PCT": [3.0, 4.0],
    "SFV3_TAG_LEVEL_ATR": [0.6, 0.8],
    "SFV3_REJECT_FRAC": [0.45, 0.55],
    "SFV3_STOP_BUFFER_ATR": [0.25, 0.40],
    "SFV3_TRAIL_ATR_MULT": [0.0, 1.5],
    "SFV3_TRAIL_ACTIVATE_RR": [0.0, 1.0]
  },
  "constraints": {
    "min_trades": 12,
    "min_profit_factor": 1.15,
    "max_drawdown": 8.0,
    "min_net_pnl": 1.0,
    "max_negative_months": 3,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.4,
    "profit_factor": 5.0,
    "winrate": 4.0,
    "max_drawdown": 2.0,
    "trades": 0.10,
    "trades_cap": 100,
    "negative_months": 2.0,
    "worst_month_pnl": 1.3
  },
  "_combo_count": "2x2x2x2x2x2x2 = 128 bounded combinations"
}
