  "score_weights": {
    "net_pnl": 1.2,
    "profit_factor": 6.0,
    "winrate": 4.0,
    "max_drawdown": 2.0,
    "trades": 0.12,
    "trades_cap": 180,
    "negative_months": 1.8,
    "worst_month_pnl": 1.4
  },
  "_combo_count": "3x3x3x3x2x3x2x3x3x3x2 = 26244 combos",
  "_goal": "Decide if Elder has a real crypto trend-pullback edge under the simple EMA50 tide model; if top candidates remain PF<1.15, demote Elder behind range/VWAP/pair-arb."
