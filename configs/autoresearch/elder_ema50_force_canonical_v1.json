  },
  "grid": {
    "ETS2_OSC_TYPE": ["force", "stoch", "rsi"],
    "ETS2_OSC_PERIOD": [2, 8, 14],
    "ETS2_OSC_OS": [25, 35, 42],
    "ETS2_OSC_OB": [58, 65, 75],
    "ETS2_ENTRY_TF": ["15", "5"],
    "ETS2_ENTRY_RETEST_BARS": [2, 3, 5],
