    "ETS2_TP1_FRAC": "0.50",
    "ETS2_TRAIL_ATR_MULT": "0.0",
    "ETS2_BE_TRIGGER_RR": "1.0",
    "ETS2_BE_LOCK_RR": "0.05",
    "ETS2_TIME_STOP_BARS_5M": "288",
    "ETS2_COOLDOWN_BARS_5M": "36",
    "ETS2_MAX_SIGNALS_PER_DAY": "4",
    "ETS2_VOL_CONFIRM": "0",
