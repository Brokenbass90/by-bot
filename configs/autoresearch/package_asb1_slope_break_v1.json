{
  "name": "package_asb1_slope_break_v1",
  "description": "Full-package additivity sweep: baseline 4 strategies + ASB1 (alt_slope_break_v1). ASB1 enters on trendline BREAKS (complement to ATT1 trendline bounces). Works in bear/chop when an ascending support line is violated with an impulsive bar. Tests whether ASB1 adds to PF vs baseline 1.591. Grid: 3*3*3*2*2 = 108 combos. Criterion: PF > 1.591 AND DD <= 7.0% AND trades >= 50.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "{SYMBOLS}",
    "--strategies",
    "alt_sloped_channel_v1,alt_resistance_fade_v1,alt_inplay_breakdown_v1,btc_eth_midterm_v3,alt_slope_break_v1",
    "--days",
    "360",
    "--end",
    "2026-05-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "3",
    "--max_positions",
    "5",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "ASC1_ALLOW_LONGS": "0",
    "ASC1_ALLOW_SHORTS": "1",
    "ASC1_SYMBOL_ALLOWLIST": "ATOMUSDT,LINKUSDT,DOTUSDT",
    "ARF1_SYMBOL_ALLOWLIST": "LINKUSDT,LTCUSDT,SUIUSDT,DOTUSDT,ADAUSDT,BCHUSDT",
    "BREAKDOWN_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ATOMUSDT,LTCUSDT",
    "BREAKDOWN_ALLOW_LONGS": "0",
    "MIDTERM_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT",
    "ASB1_ALLOW_LONGS": "0",
    "ASB1_ALLOW_SHORTS": "1",
    "ASB1_MACRO_REQUIRE_BEARISH": "1",
    "ASB1_MACRO_REQUIRE_BULLISH": "0",
    "ASB1_SIGNAL_TF": "60",
    "ASB1_PIVOT_LEFT": "3",
    "ASB1_PIVOT_RIGHT": "2",
    "ASB1_MIN_PIVOTS": "2",
    "ASB1_MAX_PIVOT_AGE": "20",
    "ASB1_MIN_R2": "0.75",
    "ASB1_TP1_RR": "1.5",
    "ASB1_TP2_RR": "3.0",
    "ASB1_TP1_FRAC": "0.50",
    "ASB1_BE_TRIGGER_RR": "1.00",
    "ASB1_TIME_STOP_BARS_5M": "480",
    "ASB1_COOLDOWN_BARS_5M": "60",
    "ASB1_MAX_OPEN_TRADES": "1"
  },
  "grid": {
    "SYMBOLS": [
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,ATOMUSDT,LTCUSDT,DOTUSDT,SUIUSDT,BCHUSDT",
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT,LTCUSDT,SUIUSDT",
      "SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT,LTCUSDT,SUIUSDT,ATOMUSDT"
    ],
    "ASB1_BREAK_ATR": ["0.20", "0.30", "0.40"],
    "ASB1_MIN_BODY_FRAC": ["0.35", "0.45", "0.55"],
    "ASB1_RSI_SHORT_MAX": ["60", "68"],
    "ASB1_SL_ATR_MULT": ["0.70", "0.90"]
  },
  "constraints": {
    "min_trades": 50,
    "min_profit_factor": 1.591,
    "max_drawdown": 7.0,
    "min_net_pnl": 0.0,
    "max_negative_months": 3,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 5.5,
    "winrate": 5.0,
    "max_drawdown": 2.0,
    "trades": 0.16,
    "trades_cap": 200,
    "negative_months": 2.0,
    "max_negative_streak": 1.5,
    "worst_month_pnl": 1.5
  },
  "_notes": {
    "fix_history": "2026-05-27: schema fix by Opus — score_weights added (was missing → ranking was trivial), corrected combo count from 54 to 108 (5 dims, not 4), added min_net_pnl + max_negative_streak constraints.",
    "combo_count": "3*3*3*2*2 = 108 combos",
    "deploy_action": "If winner: add ENABLE_ASB1_TRADING=1, ASB1_RISK_MULT=0.07, ASB1_MAX_OPEN_TRADES=1 + winner params to .env"
  }
}
