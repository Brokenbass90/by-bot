{
  "name": "range_scalp_v1_regime_repair_v1",
  "description": "Targeted next-open repair around ARS1 r004. Tests trend avoidance and stricter Bollinger/RSI extremes to remove red 2025-10/11 without discarding the positive long and short expectancy.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "ADAUSDT,LINKUSDT,DOTUSDT,LTCUSDT,SUIUSDT,ATOMUSDT,SOLUSDT",
    "--strategies",
    "alt_range_scalp_v1",
    "--days",
    "360",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "4",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2",
    "--entry-on-next-open"
  ],
  "base_env": {
    "ARS1_ALLOW_LONGS": "1",
    "ARS1_ALLOW_SHORTS": "1",
    "ARS1_BB_PERIOD": "20",
    "ARS1_MIN_BAND_WIDTH_PCT": "1.5",
    "ARS1_SL_ATR_MULT": "0.8",
    "ARS1_TP1_FRAC": "0.55",
    "ARS1_COOLDOWN_BARS_5M": "12",
    "ARS1_MIN_BODY_FRAC": "0.0",
    "ARS1_MIN_VOL_MULT": "1.1",
    "ARS1_TIME_STOP_BARS_5M": "216",
    "ARS1_SYMBOL_ALLOWLIST": "ADAUSDT,LINKUSDT,DOTUSDT,LTCUSDT,SUIUSDT,ATOMUSDT,SOLUSDT"
  },
  "grid": {
    "ARS1_MAX_ADX": [18.0, 22.0, 26.0, 30.0],
    "ARS1_BB_STD": [2.0, 2.2],
    "ARS1_RSI_LONG_MAX": [34, 38],
    "ARS1_RSI_SHORT_MIN": [58, 62],
    "ARS1_MAX_BAND_WIDTH_PCT": [18.0, 24.0]
  },
  "constraints": {
    "min_trades": 60,
    "min_profit_factor": 1.2,
    "max_drawdown": 8.0,
    "min_net_pnl": 8.0,
    "max_negative_months": 3,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 6.0,
    "winrate": 4.0,
    "max_drawdown": 1.8,
    "trades": 0.15,
    "trades_cap": 180,
    "negative_months": 3.0,
    "worst_month_pnl": 2.0
  },
  "_combo_count": 64,
  "_promotion_note": "A grid PASS still requires monthly_analysis with 2025-10/11 and temporal OOS validation before shadow promotion."
}
