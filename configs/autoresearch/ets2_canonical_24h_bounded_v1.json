{
  "name": "ets2_canonical_24h_bounded_v1",
  "description": "24h bounded Elder Triple Screen V2 validation after adding actual RR, stop percent, and entry-distance guards. This replaces the 2916-combo sweep as the first pass.",
  "cache_only": true,
  "timeout_sec": 900,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT",
    "--strategies",
    "elder_triple_screen_v2",
    "--days",
    "240",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2",
    "--entry-on-next-open"
  ],
  "base_env": {
    "BACKTEST_CACHE_ONLY": "1",
    "ETS2_ALLOW_LONGS": "1",
    "ETS2_ALLOW_SHORTS": "1",
    "ETS2_TREND_TF": "240",
    "ETS2_TREND_MODE": "macd_hist",
    "ETS2_MACD_FAST": "12",
    "ETS2_MACD_SLOW": "26",
    "ETS2_MACD_SIGNAL": "9",
    "ETS2_WAVE_TF": "60",
    "ETS2_OSC_TYPE": "force",
    "ETS2_OSC_PERIOD": "2",
    "ETS2_ENTRY_TF": "15",
    "ETS2_RISK_TF": "60",
    "ETS2_MIN_STOP_PCT": "0.002",
    "ETS2_MAX_STOP_PCT": "0.060",
    "ETS2_MIN_RR": "1.5",
    "ETS2_MAX_ENTRY_DIST_ATR": "2.0",
    "ETS2_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT"
  },
  "grid": {
    "ETS2_WAVE_LOOKBACK": [1, 2],
    "ETS2_TREND_SLOPE_BARS": [1, 2],
    "ETS2_ENTRY_MIN_BODY_FRAC": [0.10, 0.20],
    "ETS2_SL_ATR_MULT": [1.4, 1.8],
    "ETS2_TP_ATR_MULT": [2.5, 3.0],
    "ETS2_TRAIL_ATR_MULT": [0.0, 1.0]
  },
  "constraints": {
    "min_trades": 8,
    "min_profit_factor": 1.10,
    "max_drawdown": 8.0,
    "min_net_pnl": 1.0,
    "max_negative_months": 3,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.5,
    "profit_factor": 5.5,
    "winrate": 3.0,
    "max_drawdown": 2.0,
    "trades": 0.12,
    "trades_cap": 90,
    "negative_months": 2.0,
    "worst_month_pnl": 1.3
  },
  "_combo_count": "2x2x2x2x2x2 = 64 bounded combinations"
}
