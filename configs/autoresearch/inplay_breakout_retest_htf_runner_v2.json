{
  "name": "inplay_breakout_retest_htf_runner_v2",
  "description": "HTF rewrite sweep for 'proboy urovnya s retestom'. Tests the review prescription: 1h/4h levels, volume impulse confirmation, HTF ATR stop/distance, longer retest wait, and runner/partial exits. This is a repair sweep, not promotion of the failed current v1.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "{SYMBOLS}",
    "--strategies",
    "inplay_breakout",
    "--days",
    "360",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "BREAKOUT_TF_BREAK": "240",
    "BREAKOUT_TF_ENTRY": "5",
    "BREAKOUT_LOOKBACK_H": "96",
    "BREAKOUT_SL_ATR": "0.40",
    "BREAKOUT_EXIT_MODE": "runner",
    "BREAKOUT_PARTIAL_RS": "1.5,3.0,5.0",
    "BREAKOUT_PARTIAL_FRACS": "0.50,0.30,0.20",
    "BREAKOUT_TRAIL_ATR_MULT": "2.2",
    "BREAKOUT_TIME_STOP_BARS": "288",
    "BREAKOUT_REGIME_MODE": "ema",
    "BREAKOUT_REGIME_TF": "240",
    "BREAKOUT_REGIME_EMA_FAST": "20",
    "BREAKOUT_REGIME_EMA_SLOW": "50",
    "BREAKOUT_SYMBOL_ALLOWLIST": ""
  },
  "grid": {
    "SYMBOLS": [
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT",
      "DOGEUSDT,ADAUSDT,NEARUSDT,SUIUSDT",
      "WLDUSDT,SOLUSDT,LINKUSDT,NEARUSDT"
    ],
    "BREAKOUT_DIRECTION_MODE": ["long", "short", "both"],
    "BREAKOUT_IMPULSE_VOL_MULT": [1.4, 1.8],
    "BREAKOUT_IMPULSE_BODY_MIN_FRAC": [0.45, 0.60],
    "BREAKOUT_BUFFER_ATR": [0.05, 0.12],
    "BREAKOUT_SL_HTF_MULT": [0.8, 1.2],
    "BREAKOUT_MAX_DIST_HTF_MULT": [1.2, 1.8],
    "BREAKOUT_RETEST_TOUCH_ATR": [0.20, 0.35],
    "BREAKOUT_RECLAIM_ATR": [0.08],
    "BREAKOUT_MAX_RETEST_BARS": [36, 72],
    "BREAKOUT_RR": [3.0],
    "BREAKOUT_MAX_LATE_VS_REF_PCT": [0.35],
    "BREAKOUT_MIN_PULLBACK_FROM_EXTREME_PCT": [0.05]
  },
  "constraints": {
    "min_trades": 35,
    "min_profit_factor": 1.15,
    "max_drawdown": 9.0,
    "min_net_pnl": 4.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.2,
    "profit_factor": 6.0,
    "winrate": 4.0,
    "max_drawdown": 2.0,
    "trades": 0.10,
    "trades_cap": 160,
    "negative_months": 2.0,
    "worst_month_pnl": 1.5
  },
  "_combo_count": "3x3x2x2x2x2x2x2x2 = 2304 combos",
  "_goal": "Falsify or revive breakout-retest using HTF stops and runner exits; if still red, stop spending time on this family until code-level level detection is redesigned."
}
