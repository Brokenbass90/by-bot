  "score_weights": {
    "net_pnl": 1.1,
    "profit_factor": 6.0,
    "winrate": 5.0,
    "max_drawdown": 2.5,
    "trades": 0.12,
    "trades_cap": 80,
    "negative_months": 3.0,
    "max_negative_streak": 2.5,
    "worst_month_pnl": 2.0
  },
  "_notes": {
    "why": "Live flat_resistance_fade was 2/2 positive in the mixed live sample, while legacy range wrapper lost. Test ARF1 as a dedicated short-only range sleeve rather than mixing it with bidirectional BB range.",
    "combo_count": "3 symbol baskets x 3 RSI x 2 reject x 2 touch x 2 SL x 2 trail = 144 combos"
  }
