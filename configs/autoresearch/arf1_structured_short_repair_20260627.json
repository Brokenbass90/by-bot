    "backtest/run_portfolio.py",
    "--symbols",
    "{SYMBOLS}",
    "--strategies",
    "alt_resistance_fade_v1",
    "--days",
    "240",
    "--end",
    "2026-04-30",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "2",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2",
    "--entry-on-next-open"
  ],
  "base_env": {
    "BACKTEST_CACHE_ONLY": "1",
    "ARF1_SYMBOL_ALLOWLIST": "ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT,SOLUSDT,ATOMUSDT,BTCUSDT,XRPUSDT",
    "ARF1_SIGNAL_TF": "60",
    "ARF1_REGIME_TF": "240",
