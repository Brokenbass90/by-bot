    "ARF1_MAX_DIST_FROM_RES_PCT": "1.4",
    "ARF1_RSI_PERIOD": "14",
    "ARF1_TP1_FRAC": "0.60",
    "ARF1_TP2_BUFFER_PCT": "0.45",
    "ARF1_MIN_RR": "1.15",
    "ARF1_MIN_STOP_PCT": "0.0015",
    "ARF1_MAX_STOP_PCT": "0.0600",
    "ARF1_TIME_STOP_BARS_5M": "576",
    "ARF1_COOLDOWN_BARS_5M": "48",
    "ARF1_REJECT_REQUIRE_LOWER_CLOSE": "1"
