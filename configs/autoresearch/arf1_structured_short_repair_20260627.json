  "constraints": {
    "min_trades": 10,
    "min_profit_factor": 1.15,
    "max_drawdown": 8.0,
    "min_net_pnl": 0.5,
    "max_negative_months": 3,
    "max_negative_streak": 2,
    "min_winrate": 0.42
