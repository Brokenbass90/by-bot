{
  "name": "ivb1_dd_repair_20260627",
  "description": "DD-repair sweep for IVB1 short-only. Uses drawdown-doctor findings: BTC/SOL hurt, ADA/DOGE/ETH/LINK carry; many losses are stop_then_reversed/gave_back_profit, so test symbol gating, wider SL, BE timing, trail and runner.",
  "cache_only": true,
  "timeout_sec": 900,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "{SYMBOLS}",
    "--strategies",
    "impulse_volume_breakout_v1",
    "--days",
    "240",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "2",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2",
    "--entry-on-next-open"
  ],
  "base_env": {
    "BACKTEST_CACHE_ONLY": "1",
    "IVB1_DIRECTION_MODE": "short_only",
    "IVB1_REGIME_MODE": "off",
    "IVB1_MACRO_REQUIRE_BULL": "0",
    "IVB1_BREAKOUT_LOOKBACK_BARS": "24",
    "IVB1_IMPULSE_LOOKBACK_BARS": "18",
    "IVB1_VOL_PERIOD": "20",
    "IVB1_MIN_IMPULSE_PCT": "0.045",
    "IVB1_MIN_BAR_RANGE_ATR": "1.2",
    "IVB1_BREAKOUT_BUFFER_ATR": "0.0",
    "IVB1_RETRACE_MIN_FRAC": "0.10",
    "IVB1_RETRACE_MAX_FRAC": "0.45",
    "IVB1_RECLAIM_ATR": "0.08",
    "IVB1_ENTRY_BODY_MIN_FRAC": "0.25",
    "IVB1_TOUCH_BELOW_BREAKOUT_ATR": "0.20",
    "IVB1_INVALIDATION_CLOSE_ATR": "0.35",
    "IVB1_TP1_RR": "0.9",
    "IVB1_TIME_STOP_BARS_5M": "72",
    "IVB1_COOLDOWN_BARS_5M": "12",
    "IVB1_MIN_RR": "1.5",
    "IVB1_MAX_ENTRY_DIST_ATR": "2.0",
    "IVB1_MIN_VOL_MULT": "1.2"
  },
  "grid": {
    "SYMBOLS": [
      "ADAUSDT,DOGEUSDT,ETHUSDT,LINKUSDT",
      "ADAUSDT,DOGEUSDT,ETHUSDT,LINKUSDT,LTCUSDT",
      "ADAUSDT,DOGEUSDT,LINKUSDT"
    ],
    "IVB1_SL_ATR": ["0.75", "0.95"],
    "IVB1_BE_TRIGGER_RR": ["0.6", "0.9"],
    "IVB1_TRAIL_ATR_MULT": ["1.0", "1.6"],
    "IVB1_RR": ["2.2", "3.0"]
  },
  "constraints": {
    "min_trades": 30,
    "min_profit_factor": 1.20,
    "max_drawdown": 8.0,
    "min_net_pnl": 4.0,
    "max_negative_months": 3,
    "max_negative_streak": 2,
    "min_winrate": 0.42
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 6.0,
    "winrate": 4.0,
    "max_drawdown": 3.0,
    "trades": 0.08,
    "trades_cap": 160,
    "negative_months": 3.0,
    "max_negative_streak": 3.0,
    "worst_month_pnl": 1.5
  },
  "_combo_count": "3 baskets x 2 SL x 2 BE x 2 trail x 2 runner = 48 combinations"
}
