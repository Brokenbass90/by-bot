{
  "name": "package_att1_rsi_relax_v1",
  "description": "ATT1 RSI filter is too strict: RSI_LONG_MAX=52 blocks most longs in any trending market (normal pullback RSI = 50-60). Test relaxation to 55/58/62. Also probe SHORT_MIN (currently 40, very loose). Baseline PF=1.591. Full-package replay (ATT1 + ARF1 + Breakdown + Midterm). Grid: 4*3*3 = 36 combos.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT",
    "--strategies",
    "alt_trendline_touch_v1,alt_resistance_fade_v1,alt_inplay_breakdown_v1,btc_eth_midterm_pullback",
    "--days",
    "365",
    "--end",
    "2026-04-25",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.01",
    "--leverage",
    "1",
    "--max_positions",
    "5",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "ATT1_ALLOW_LONGS": "1",
    "ATT1_ALLOW_SHORTS": "1",
    "ATT1_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT",
    "ATT1_PIVOT_LEFT": "2",
    "ATT1_PIVOT_RIGHT": "3",
    "ATT1_MIN_PIVOTS": "2",
    "ATT1_MAX_PIVOT_AGE": "20",
    "ATT1_MIN_R2": "0.7",
    "ATT1_TOUCH_ATR": "0.5",
    "BREAKDOWN_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT",
    "BREAKDOWN_ALLOW_SHORTS": "1",
    "BREAKDOWN_ALLOW_LONGS": "0",
    "BREAKDOWN_ALLOW_FAILED_RECLAIM": "1",
    "BREAKDOWN_ALLOW_CONTINUATION": "1",
    "BREAKDOWN_REGIME_MODE": "ema",
    "BREAKDOWN_BUFFER_ATR": "0.10",
    "BREAKDOWN_MIN_BREAK_ATR": "0.20",
    "BREAKDOWN_SL_ATR": "1.8",
    "BREAKDOWN_RR": "2.0",
    "BREAKDOWN_MAX_DIST_ATR": "2.0",
    "ARF1_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT",
    "ARF1_MIN_RSI": "52.0",
    "ARF1_RES_TOUCH_BUFFER_ATR": "0.35",
    "ARF1_REJECT_BELOW_RES_ATR": "0.10",
    "MTPB3_ALLOW_LONGS": "1",
    "MTPB3_ALLOW_SHORTS": "1",
    "MTPB3_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT"
  },
  "grid": {
    "ATT1_RSI_LONG_MAX": ["52", "55", "58", "62"],
    "ATT1_RSI_SHORT_MIN": ["38", "42", "45"],
    "ATT1_SL_ATR_MULT": ["1.0", "1.1", "1.3"]
  },
  "constraints": {
    "min_trades": 50,
    "min_profit_factor": 1.591,
    "max_drawdown": 7.0,
    "min_net_pnl": 0.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 5.5,
    "winrate": 5.0,
    "max_drawdown": 2.0,
    "trades": 0.16,
    "trades_cap": 200,
    "negative_months": 2.0,
    "max_negative_streak": 1.5,
    "worst_month_pnl": 1.5
  },
  "_notes": {
    "fix_history": "2026-05-27: schema fix by Opus — grid converted from list-of-dicts to dict, pass_criteria renamed to constraints, score_weights added. Original logic preserved.",
    "hypothesis": "RSI_LONG_MAX=52 blocks longs in normal bull pullback (RSI typically 55-65). Relax to find sweet spot without flooding losers.",
    "combo_count": "4*3*3 = 36 combos",
    "baseline_pf": 1.591,
    "winner_promotion": "If passing winner with PF > 1.591 and DD <= 7.0: copy ATT1_RSI_LONG_MAX, ATT1_RSI_SHORT_MIN, ATT1_SL_ATR_MULT to .env approved_strategy_params section."
  }
}
