{
  "name": "inplay_retest_v3_level_retest_repair_v1",
  "description": "Repair sweep for the human-trader setup: strong horizontal/sloped level -> retest-hold -> tight stop behind level -> TP before next level + runner. This replaces the old IVB/reclaim-chase logic and looks for annual pockets with fewer red months after fees.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "{SYMBOLS}",
    "--strategies",
    "inplay_retest_v3",
    "--days",
    "360",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "{MAX_POSITIONS}",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "IRV3_USE_REGIME": "0",
    "IRV3_USE_SLOPED": "1",
    "IRV3_LEVEL_LOOKBACK": "240",
    "IRV3_ENTRY_LOOKBACK": "96",
    "IRV3_ATR_PERIOD": "14",
    "IRV3_TP1_FRAC": "0.60",
    "IRV3_BE_TRIGGER_RR": "1.0",
    "IRV3_COOLDOWN_BARS": "3",
    "IRV3_MIN_STOP_PCT": "0.0015",
    "IRV3_MAX_STOP_PCT": "0.0600"
  },
  "grid": {
    "SYMBOLS": [
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT",
      "ADAUSDT,DOGEUSDT,NEARUSDT,SUIUSDT",
      "SOLUSDT,LINKUSDT,NEARUSDT,DOTUSDT,LTCUSDT"
    ],
    "MAX_POSITIONS": [2],
    "IRV3_STRUCTURE_TF": ["240", "60"],
    "IRV3_ENTRY_TF": ["15"],
    "IRV3_MIN_TOUCHES": [3, 2],
    "IRV3_LEVEL_TOL_ATR": [0.35, 0.25, 0.50],
    "IRV3_RETEST_BAND_ATR": [0.45],
    "IRV3_TOUCH_INTO_ATR": [0.20, 0.35],
    "IRV3_MAX_PIERCE_ATR": [0.35],
    "IRV3_REJECT_FRAC": [0.50, 0.35],
    "IRV3_VOL_MULT": [1.15, 0.0],
    "IRV3_STOP_BUFFER_ATR": [0.40, 0.25],
    "IRV3_TP_BEFORE_LEVEL_ATR": [0.15, 0.30],
    "IRV3_MIN_RR_TP1": [1.15, 0.90],
    "IRV3_RR_RUNNER": [2.0, 3.0],
    "IRV3_ALLOW_LONG": ["1"],
    "IRV3_ALLOW_SHORT": ["1"]
  },
  "constraints": {
    "min_trades": 25,
    "min_profit_factor": 1.12,
    "max_drawdown": 9.0,
    "min_net_pnl": 4.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.2,
    "profit_factor": 6.0,
    "winrate": 3.0,
    "max_drawdown": 2.0,
    "trades": 0.12,
    "trades_cap": 180,
    "negative_months": 2.4,
    "worst_month_pnl": 1.8
  },
  "_combo_count": "3x1x2x1x2x3x1x2x1x2x2x2x2x2x2 = 13824 combos; run with a bounded --limit first",
  "_goal": "Find whether the corrected level-retest logic can recover the old annual edge while reducing red months. PASS candidates still need monthly_analysis and stack_comparison before canary."
}
