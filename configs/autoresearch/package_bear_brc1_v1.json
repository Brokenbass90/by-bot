{
  "name": "package_bear_brc1_v1",
  "description": "Adds BRC1 (Bear Regime Continuation, short-only for bear/chop) to the full package. 90d focused sweep showed PF 4.80, WR 67.7%, DD 0.40%, 0 red months. Validates on 365d window covering bear-2022 + bull-2021/2023. Baseline: +73.96%, PF 1.591, DD 5.16%. Only combos with PF > 1.591 pass. Grid: 3*3*3*3 = 81 combos.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT",
    "--strategies",
    "alt_trendline_touch_v1,alt_resistance_fade_v1,alt_inplay_breakdown_v1,btc_eth_midterm_pullback,alt_bear_regime_continuation_v1",
    "--days",
    "365",
    "--end",
    "2026-04-25",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.01",
    "--leverage",
    "1",
    "--max_positions",
    "5",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "ATT1_ALLOW_LONGS": "1",
    "ATT1_ALLOW_SHORTS": "1",
    "ATT1_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT",
    "ATT1_PIVOT_LEFT": "2",
    "ATT1_PIVOT_RIGHT": "3",
    "ATT1_MIN_PIVOTS": "2",
    "ATT1_MAX_PIVOT_AGE": "20",
    "ATT1_MIN_R2": "0.7",
    "ATT1_TOUCH_ATR": "0.5",
    "ATT1_RSI_LONG_MAX": "52",
    "ATT1_RSI_SHORT_MIN": "40",
    "BREAKDOWN_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT",
    "BREAKDOWN_ALLOW_SHORTS": "1",
    "BREAKDOWN_ALLOW_LONGS": "0",
    "BREAKDOWN_ALLOW_FAILED_RECLAIM": "1",
    "BREAKDOWN_ALLOW_CONTINUATION": "1",
    "BREAKDOWN_REGIME_MODE": "ema",
    "BREAKDOWN_BUFFER_ATR": "0.10",
    "BREAKDOWN_MIN_BREAK_ATR": "0.20",
    "BREAKDOWN_SL_ATR": "1.8",
    "BREAKDOWN_RR": "2.0",
    "BREAKDOWN_MAX_DIST_ATR": "2.0",
    "ARF1_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT",
    "ARF1_MIN_RSI": "52.0",
    "ARF1_RES_TOUCH_BUFFER_ATR": "0.35",
    "ARF1_REJECT_BELOW_RES_ATR": "0.10",
    "MTPB3_ALLOW_LONGS": "1",
    "MTPB3_ALLOW_SHORTS": "1",
    "MTPB3_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT",
    "ENABLE_BRC1_TRADING": "1",
    "BRC1_RISK_MULT": "0.08",
    "BRC1_MAX_OPEN_TRADES": "1"
  },
  "grid": {
    "BRC1_PULLBACK_MIN_PCT": ["0.3", "0.4", "0.5"],
    "BRC1_RSI_MIN": ["48", "50", "52"],
    "BRC1_RSI_MAX": ["65", "70", "75"],
    "BRC1_SYMBOL_ALLOWLIST": [
      "BTCUSDT,ETHUSDT,SOLUSDT",
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT",
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT,LTCUSDT"
    ]
  },
  "constraints": {
    "min_trades": 50,
    "min_profit_factor": 1.591,
    "max_drawdown": 7.0,
    "min_net_pnl": 0.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 5.5,
    "winrate": 5.0,
    "max_drawdown": 2.0,
    "trades": 0.16,
    "trades_cap": 200,
    "negative_months": 2.0,
    "max_negative_streak": 1.5,
    "worst_month_pnl": 1.5
  },
  "_notes": {
    "fix_history": "2026-05-27: schema fix by Opus — grid converted to dict, pass_criteria renamed to constraints, score_weights added, ENABLE_BRC1_TRADING/RISK_MULT/MAX_OPEN_TRADES added to base_env for clarity (backtest uses --strategies but explicit flags help diagnose).",
    "hypothesis": "BRC1 designed for bear/chop pullback shorts. 90d window flattering; 365d covers bull periods too. If still passes baseline PF=1.591, additivity is real.",
    "combo_count": "3*3*3*3 = 81 combos",
    "baseline_pf": 1.591,
    "winner_promotion": "If passing winner with PF > 1.591 and DD <= 7.0: add to .env ENABLE_BRC1_TRADING=1, BRC1_PULLBACK_MIN_PCT, BRC1_RSI_MIN/MAX, BRC1_SYMBOL_ALLOWLIST, BRC1_RISK_MULT=0.08."
  }
}
