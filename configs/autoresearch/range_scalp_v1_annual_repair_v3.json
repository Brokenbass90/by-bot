{
  "name": "range_scalp_v1_annual_repair_v3",
  "description": "Annual repair sweep for the range-boundary scalp ('pila ot granits fleta'). Adds optional ADX anti-trend gate, body confirmation, volume confirmation, looser RSI, and faster cooldown to test whether the current green edge can become more frequent without adding bear-month fragility.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "ADAUSDT,LINKUSDT,DOTUSDT,LTCUSDT,SUIUSDT,ATOMUSDT,SOLUSDT",
    "--strategies",
    "alt_range_scalp_v1",
    "--days",
    "360",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "{MAX_POSITIONS}",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "ARS1_ALLOW_LONGS": "1",
    "ARS1_ALLOW_SHORTS": "1",
    "ARS1_BB_PERIOD": "20",
    "ARS1_BB_STD": "2.0",
    "ARS1_TIME_STOP_BARS_5M": "216",
    "ARS1_SYMBOL_ALLOWLIST": "ADAUSDT,LINKUSDT,DOTUSDT,LTCUSDT,SUIUSDT,ATOMUSDT,SOLUSDT",
    "ARS1_ADX_PERIOD": "14"
  },
  "grid": {
    "ARS1_MIN_BAND_WIDTH_PCT": [1.5, 2.5, 3.5],
    "ARS1_MAX_BAND_WIDTH_PCT": [24.0, 30.0],
    "ARS1_RSI_LONG_MAX": [38, 42, 45],
    "ARS1_RSI_SHORT_MIN": [55, 58, 62],
    "ARS1_SL_ATR_MULT": [0.8, 1.0],
    "ARS1_TP1_FRAC": [0.55, 0.70],
    "ARS1_COOLDOWN_BARS_5M": [12, 24, 48],
    "ARS1_MAX_ADX": [0.0, 24.0, 30.0],
    "ARS1_MIN_BODY_FRAC": [0.0, 0.25],
    "ARS1_MIN_VOL_MULT": [0.0, 1.10],
    "MAX_POSITIONS": [3, 4]
  },
  "constraints": {
    "min_trades": 80,
    "min_profit_factor": 1.20,
    "max_drawdown": 10.0,
    "min_net_pnl": 8.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 6.0,
    "winrate": 4.0,
    "max_drawdown": 1.8,
    "trades": 0.15,
    "trades_cap": 260,
    "negative_months": 2.2,
    "worst_month_pnl": 1.5
  },
  "_combo_count": "3x2x3x3x2x2x3x3x2x2x2 = 15552 combos",
  "_goal": "Find a higher-frequency annual-safe range scalp pocket; keep only configs that stay green enough through bear months after fees/slippage."
}
