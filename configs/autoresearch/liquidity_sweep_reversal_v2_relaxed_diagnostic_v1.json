{
  "name": "liquidity_sweep_reversal_v2_relaxed_diagnostic_v1",
  "description": "Diagnostic LSR2 sweep after strict audit grid produced zero trades. Goal is to test whether the mechanism is alive under realistic but less over-constrained gates before any portfolio discussion.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT,LTCUSDT,SUIUSDT",
    "--strategies",
    "alt_liquidity_sweep_reversal_v2",
    "--days",
    "360",
    "--end",
    "2026-04-30",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.0075",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "LQH2_ALLOW_LONGS": "1",
    "LQH2_ALLOW_SHORTS": "1",
    "LQH2_REGIME_MODE": "all",
    "LQH2_RR": "2.0",
    "LQH2_TP1_RR": "1.0",
    "LQH2_TP1_FRAC": "0.50",
    "LQH2_BREAKEVEN_AFTER_TP1": "1",
    "LQH2_TRAIL_ATR_MULT": "1.0",
    "LQH2_TIME_STOP_BARS": "144",
    "LQH2_VOL_MODE": "quote",
    "LQH2_POOL_COOLDOWN_BARS_5M": "24",
    "LQH2_MAX_ADX": "0",
    "LQH2_MIN_REJECT_WICK_ATR": "0.05",
    "LQH2_MIN_WICK_TO_BODY": "1.0",
    "LQH2_MAX_BODY_ATR": "1.0",
    "LQH2_MAX_EMA_GAP_ATR": "2.5"
  },
  "grid": {
    "LQH2_LOOKBACK_BARS": [36, 48],
    "LQH2_MIN_POOL_TOUCHES": [2, 3],
    "LQH2_POOL_TOUCH_ATR": [0.20],
    "LQH2_POOL_PERSISTENCE_BARS": [0, 4],
    "LQH2_MIN_POOL_WIDTH_ATR": [0.5, 1.0],
    "LQH2_MIN_SWEEP_ATR": [0.05, 0.10],
    "LQH2_MAX_SWEEP_ATR": [1.5],
    "LQH2_MIN_VOL_MULT": [0.8, 1.0]
  },
  "constraints": {
    "min_trades": 20,
    "min_profit_factor": 1.15,
    "max_drawdown": 12.0,
    "min_net_pnl": 3.0,
    "max_negative_months": 5,
    "max_negative_streak": 3
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 5.0,
    "winrate": 4.0,
    "max_drawdown": 2.0,
    "trades": 0.08,
    "trades_cap": 160,
    "negative_months": 1.5,
    "worst_month_pnl": 1.2
  },
  "_combo_count": "2x2x1x2x2x2x1x2 = 64 combos",
  "_promotion_note": "A pass here is research evidence only. Promotion still requires OOS/walk-forward and additivity against live portfolio."
}
