{
  "name": "sloped_channel_long_only_v1",
  "description": "Pair-2: ASC1 (alt_sloped_channel_v1) LONG-only sweep. Goal: per-side params (R², slope, depth, RSI) для лонгов отдельно от шортов. Текущий live ASC1 в bear_chop = shorts only. Найти лучший LONG params + регимы. Pair: sloped_channel_short_only_v1.json.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "{SYMBOLS}",
    "--strategies",
    "alt_sloped_channel_v1",
    "--days",
    "360",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.0075",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "ASC1_ALLOW_LONGS": "1",
    "ASC1_ALLOW_SHORTS": "0",
    "ASC1_TRAIL_ATR_MULT": "0.0",
    "ASC1_TIME_STOP_BARS_5M": "480"
  },
  "grid": {
    "SYMBOLS": [
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT,LTCUSDT",
      "ADAUSDT,LINKUSDT,DOTUSDT,LTCUSDT,SUIUSDT,ATOMUSDT"
    ],
    "ASC1_MIN_RANGE_R2": [0.45, 0.55, 0.65],
    "ASC1_LONG_MAX_NEG_SLOPE_PCT": [0.0, 0.05, 0.10],
    "ASC1_LONG_MIN_REJECT_DEPTH_ATR": [0.6, 0.8, 1.0],
    "ASC1_LONG_MAX_RSI": [38, 42, 45],
    "ASC1_CONFIRM_5M_BARS": [4, 6]
  },
  "constraints": {
    "min_trades": 40,
    "min_profit_factor": 1.25,
    "max_drawdown": 8.0,
    "min_net_pnl": 6.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.3,
    "profit_factor": 6.0,
    "winrate": 4.5,
    "max_drawdown": 2.0,
    "trades": 0.14,
    "trades_cap": 200,
    "negative_months": 2.0,
    "worst_month_pnl": 1.5
  },
  "_combo_count": "2x3x3x3x3x2 = 324 combos",
  "_pair": "sloped_channel_short_only_v1.json",
  "_note": "ASC1_LONG_* env vars НОВЫЕ — нужно проверить, что strategy code их читает. Если нет — fallback на общие ASC1_MAX_NEG_SLOPE_PCT и т.п. До runs убедиться."
}
