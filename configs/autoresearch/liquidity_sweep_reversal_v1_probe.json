{
  "name": "liquidity_sweep_reversal_v1_probe",
  "description": "Research-only crypto liquidity hunter: rolling high/low pool sweep, close back inside, wick rejection, volume context, and stop beyond sweep wick. Tests whether stop-hunt price action has standalone edge before adding order-book/liquidation-map data.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT,LTCUSDT,SUIUSDT",
    "--strategies",
    "alt_liquidity_sweep_reversal_v1",
    "--days",
    "360",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "3",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "LQH_SYMBOL_ALLOWLIST": "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT,LTCUSDT,SUIUSDT",
    "LQH_POOL_TOUCH_ATR": "0.18",
    "LQH_MAX_SWEEP_ATR": "0.90",
    "LQH_RECLAIM_ATR": "0.04",
    "LQH_MIN_REJECT_WICK_ATR": "0.10",
    "LQH_MAX_BODY_ATR": "0.60",
    "LQH_MAX_EMA_GAP_ATR": "2.4",
    "LQH_SL_PAD_ATR": "0.12",
    "LQH_MAX_RISK_ATR": "1.30",
    "LQH_TIME_STOP_BARS_5M": "48",
    "LQH_COOLDOWN_BARS_5M": "24"
  },
  "grid": {
    "LQH_SIDE_MODE": ["long", "short", "both"],
    "LQH_LOOKBACK_BARS": [24, 36, 48],
    "LQH_MIN_POOL_TOUCHES": [1, 2],
    "LQH_MIN_POOL_WIDTH_ATR": [0.3, 0.8],
    "LQH_MIN_SWEEP_ATR": [0.08, 0.12],
    "LQH_MIN_VOL_MULT": [0.8, 1.0, 1.25],
    "LQH_MIN_WICK_TO_BODY": [0.6, 1.0, 1.3],
    "LQH_RR": [1.2, 1.5, 1.8]
  },
  "constraints": {
    "min_trades": 45,
    "min_profit_factor": 1.18,
    "max_drawdown": 10.0,
    "min_net_pnl": 5.0,
    "max_negative_months": 4,
    "max_negative_streak": 2
  },
  "score_weights": {
    "net_pnl": 1.4,
    "profit_factor": 6.0,
    "winrate": 6.0,
    "max_drawdown": 1.8,
    "trades": 0.06,
    "trades_cap": 160,
    "negative_months": 2.0,
    "worst_month_pnl": 2.0
  },
  "_combo_count": "3x3x2x2x2x3x3x3 = 1944 combos",
  "_promotion_path": "standalone annual PASS -> additivity vs crypto_income_live_canary_v2 -> WF-22 -> only then live candidate"
}
