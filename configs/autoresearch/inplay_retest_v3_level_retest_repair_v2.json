{
  "name": "inplay_retest_v3_level_retest_repair_v2",
  "description": "Anti-lookahead repair sweep for the human-trader setup: historical strong level -> current closed-bar retest-hold -> tight stop behind level -> TP before next level + runner. Use this instead of v1 after the closed-history fix.",
  "cache_only": true,
  "command": [
    "{python}",
    "backtest/run_portfolio.py",
    "--symbols",
    "{SYMBOLS}",
    "--strategies",
    "inplay_retest_v3",
    "--days",
    "360",
    "--end",
    "2026-04-01",
    "--tag",
    "{tag}",
    "--starting_equity",
    "100",
    "--risk_pct",
    "0.005",
    "--leverage",
    "1",
    "--max_positions",
    "{MAX_POSITIONS}",
    "--fee_bps",
    "6",
    "--slippage_bps",
    "2"
  ],
  "base_env": {
    "IRV3_USE_REGIME": "0",
    "IRV3_USE_SLOPED": "1",
    "IRV3_LEVEL_LOOKBACK": "240",
    "IRV3_ENTRY_LOOKBACK": "96",
    "IRV3_ATR_PERIOD": "14",
    "IRV3_TP1_FRAC": "0.60",
    "IRV3_BE_TRIGGER_RR": "1.0",
    "IRV3_COOLDOWN_BARS": "3",
    "IRV3_MIN_STOP_PCT": "0.0015",
    "IRV3_MAX_STOP_PCT": "0.0600"
  },
  "grid": {
    "SYMBOLS": [
      "BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT",
      "ADAUSDT,DOGEUSDT,NEARUSDT,SUIUSDT"
    ],
    "MAX_POSITIONS": [2],
    "IRV3_STRUCTURE_TF": ["240", "60"],
    "IRV3_ENTRY_TF": ["15"],
    "IRV3_MIN_TOUCHES": [3],
    "IRV3_LEVEL_TOL_ATR": [0.35, 0.50],
    "IRV3_RETEST_BAND_ATR": [0.45, 0.60],
    "IRV3_TOUCH_INTO_ATR": [0.20, 0.35],
    "IRV3_MAX_PIERCE_ATR": [0.35],
    "IRV3_REJECT_FRAC": [0.50, 0.40],
    "IRV3_VOL_MULT": [1.15, 0.0],
    "IRV3_STOP_BUFFER_ATR": [0.25, 0.40],
    "IRV3_TP_BEFORE_LEVEL_ATR": [0.15, 0.30],
    "IRV3_MIN_RR_TP1": [1.15],
    "IRV3_RR_RUNNER": [2.0, 3.0],
    "IRV3_ALLOW_LONG": ["1"],
    "IRV3_ALLOW_SHORT": ["1"]
  },
  "constraints": {
    "min_trades": 60,
    "min_profit_factor": 1.15,
    "max_drawdown": 8.0,
    "min_net_pnl": 5.0,
    "max_negative_months": 3,
    "max_negative_streak": 2,
    "min_winrate": 0.45,
    "min_avg_win_loss_ratio": 1.2
  },
  "score_weights": {
    "net_pnl": 1.2,
    "profit_factor": 6.0,
    "winrate": 3.0,
    "max_drawdown": 2.0,
    "trades": 0.10,
    "trades_cap": 180,
    "negative_months": 3.0,
    "max_negative_streak": 2.0,
    "worst_month_pnl": 2.0
  },
  "_combo_count": "2x1x2x1x1x2x2x2x1x2x2x2x2x1x2x1x1 = 1024 combos; run a bounded --limit smoke first, then OOS/monthly/stack comparison for any PASS.",
  "_go_next": "PASS candidates are not live candidates until monthly_analysis, walk-forward/OOS, and stack_comparison confirm the edge without red-month concentration."
}
