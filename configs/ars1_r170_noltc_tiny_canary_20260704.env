# ─────────────────────────────────────────────────────────────────────────────
# ARS1 r170 no-LTC — tiny canary proposal, 2026-07-04
# Strategy: alt_range_scalp_v1 / live sleeve key: range
# Status: PROPOSAL ONLY. Do not source on live without explicit owner OK.
#
# Evidence:
# - Server revalidate r170, 360d through 2026-04-30:
#   68 trades, +13.12R, PF 1.864, DD 3.34R.
# - Local no-LTC diagnostic:
#   70 trades, +12.91R, PF 1.825, DD 3.66R, 2 red months / 10.
# - Local no-LTC rolling 4x90d:
#   +3.47R / -0.12R / +3.60R / +5.78R,
#   3/4 positive folds, median +3.54R, oos_selector=robust_plateau.
# - Additivity sanity with ATT1 r001:
#   ATT1 solo: 290 trades, +27.77R, PF 1.402, DD 6.55R, 2 red months.
#   ATT1 + ARS1 no-LTC fixed: 407 trades, +33.35R, PF 1.397,
#   DD 7.16R, 2 red months.
#
# Decision:
# - ARS1 no-LTC is a credible candidate for sleeve #2, but it slightly
#   increases DD vs ATT1 solo. Start only as tiny canary or shadow.
# - Exclude LTC: it was the weakest symbol in r170.
# - Do NOT use old legacy `range` results. This is ARS1 alt_range_scalp_v1 only.
# ─────────────────────────────────────────────────────────────────────────────

ENABLE_RANGE_TRADING=1

# Tiny by design. With current effective account risk ~0.44%, this means
# nominal ARS1 risk ≈ equity * 0.44% * 0.03.
RANGE_RISK_MULT=0.03

ARS1_SYMBOL_ALLOWLIST=ADAUSDT,LINKUSDT,DOTUSDT,SUIUSDT
ARS1_ALLOW_LONGS=1
ARS1_ALLOW_SHORTS=1

ARS1_BB_PERIOD=20
ARS1_BB_STD=2.0
ARS1_MIN_BAND_WIDTH_PCT=1.5
ARS1_MAX_BAND_WIDTH_PCT=24.0
ARS1_RSI_LONG_MAX=38
ARS1_RSI_SHORT_MIN=55

ARS1_SL_ATR_MULT=0.8
ARS1_TP1_FRAC=0.55
ARS1_MIN_RR=1.15
ARS1_MIN_STOP_PCT=0.0015
ARS1_MAX_STOP_PCT=0.0600
ARS1_TIME_STOP_BARS_5M=216
ARS1_COOLDOWN_BARS_5M=12

ARS1_ADX_PERIOD=14
ARS1_MAX_ADX=0.0
ARS1_MIN_VOL_MULT=1.1
ARS1_RECLAIM_ATR=0.0
ARS1_TRAIL_ATR_MULT=0.0
ARS1_TRAIL_ACTIVATE_RR=1.0

# Keep ATT1 as the primary proven sleeve. This file is meant to be layered
# after configs/att1_short_r001_canary_20260702.env only if owner approves.
