# ─────────────────────────────────────────────────────────────────────────────
# Alpaca LIVE env — monthly v38, capped $500 (TEMPLATE, no secrets)
# Copy to configs/alpaca_live_v38.env on the SERVER, fill the two keys, keep it
# OUT of git (configs/alpaca_live_v38.env should be gitignored).
# Launch: source the v38 sizing first, then this file:
#   set -a; source configs/alpaca_v38_hybrid_top4_candidate.env; source configs/alpaca_live_v38.env; set +a
#   python3 scripts/equities_alpaca_paper_bridge.py   # dry-run first (SEND_ORDERS=0)
# ─────────────────────────────────────────────────────────────────────────────

# Real-money endpoint (NOT paper). The live-order guard only arms when base_url
# is non-paper AND ALPACA_SEND_ORDERS=1.
ALPACA_BASE_URL=https://api.alpaca.markets

# LIVE account keys — fill on server, never commit.
ALPACA_API_KEY_ID=__FILL_LIVE_KEY__
ALPACA_API_SECRET_KEY=__FILL_LIVE_SECRET__

# Fail-closed live guard (all three required by the bridge for live orders).
ALPACA_LIVE_ACCOUNT_ROLE=monthly_v38
ALPACA_LIVE_CONFIRM=MONTHLY_V38_LIVE
ALPACA_LIVE_MAX_CAPITAL_USD=500
ALPACA_CAPITAL_OVERRIDE_USD=500

# Broker-side protection MUST stay required (close position if a stop can't be set).
ALPACA_BROKER_PROTECTION_ENABLE=1
ALPACA_BROKER_PROTECTION_REQUIRED=1

# ── SAFETY: start in dry-run. Flip to 1 ONLY after the dry-run output looks right
#    (LIVE account shown, sane tickers, each BUY has a stop, total notional <= $500)
#    and after US market open (09:30 ET).
ALPACA_SEND_ORDERS=0
