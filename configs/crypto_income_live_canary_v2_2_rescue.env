## Crypto income live canary v2.2 RESCUE — 2026-05-XX
##
## Контекст: Codex rescue-comparison показал что в 180d лучшие — ATT1 + support_bounce.
##   ATT1: +23.74, PF 1.605
##   support_bounce: +16.67, PF 1.813
##   midterm: +1.39 (тоненько)
##   flat: -0.61 (минусует)
##   IVB1: -2.20, inplay: -1.25
##
## Этот env усиливает ядро ATT1 + support_bounce и ослабляет проблемные.
## Также включает 2 новые Claude-стратегии в РЕЖИМЕ shadow (zero risk_mult в начале):
##   - alt_spike_rejection_v1 (SPR1)        — пользовательская идея
##   - alt_bear_regime_continuation_v1 (BRC1) — short в текущей медвежке
##
## После 7 дней shadow + autoresearch validation → поднимаем mult если PF проходит.

## ── CORE — proven 180d ATT1+support_bounce ───────────────────────────────────
ENABLE_ATT1_TRADING=1
ENABLE_BOUNCE_TRADING=1
ENABLE_BOUNCE1_TRADING=1

## ── REDUCED — flat/midterm с пониженным риском (минусует/тонко) ──────────────
ENABLE_FLAT_TRADING=1
ENABLE_MIDTERM_TRADING=1

## ── DISABLED — IVB1/inplay в ремонт ──────────────────────────────────────────
ENABLE_IMPULSE_TRADING=0
ENABLE_BREAKOUT_TRADING=0
ENABLE_BREAKDOWN_TRADING=0
ENABLE_RANGE_TRADING=0
ENABLE_ASM1_TRADING=0

## ── V7 OFF (как и раньше) ────────────────────────────────────────────────────
ENABLE_BREAKDOWN2_TRADING=0
ENABLE_SLOPE_CHOCH_TRADING=0
ENABLE_LC_TRADING=0
ENABLE_FR_TRADING=0
ENABLE_MSCALP_TRADING=0
ENABLE_SOB1_TRADING=0
ENABLE_VWAP_TRADING=0

## ── NEW Claude strategies — SHADOW MODE (mult=0 = log only) ──────────────────
ENABLE_SPR1_TRADING=1
SPR1_RISK_MULT=0.0
SPR1_REGIME_MODE=all
SPR1_ENABLE_FLIP=1

ENABLE_BRC1_TRADING=1
BRC1_RISK_MULT=0.0

## ── REGIME OVERLAY — критично, без этого 0 trades баг повторится ─────────────
REGIME_OVERLAY_ENABLE=1

## ── BASE RISK ────────────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=1.0
BYBIT_LEVERAGE=3
MAX_POSITIONS=3
MAX_OPEN_PORTFOLIO_RISK_PCT=2.0

## ── SLEEVE MULTS — ATT1 / support_bounce увеличены, flat/midterm урезаны ─────
ORCH_GLOBAL_RISK_MULT=0.55
ATT1_RISK_MULT=1.00       # core, было 0.85
BOUNCE_RISK_MULT=0.85     # NEW emphasis, support_bounce 180d показал PF 1.81
BOUNCE1_RISK_MULT=0.85    # live key for alt_support_bounce_v1 wrapper
FLAT_RISK_MULT=0.35       # понижено (минусует)
MIDTERM_RISK_MULT=0.40    # понижено (тонко)

## ── ATT1 params ──────────────────────────────────────────────────────────────
ATT1_MAX_OPEN_TRADES=2
ATT1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ATT1_PIVOT_LEFT=2
ATT1_PIVOT_RIGHT=3
ATT1_MIN_PIVOTS=2
ATT1_MAX_PIVOT_AGE=20
ATT1_MIN_R2=0.7
ATT1_TOUCH_ATR=0.5

## ── support_bounce (ASB1) — теперь PRIMARY long ──────────────────────────────
ASB1_MAX_OPEN_TRADES=2
BOUNCE1_MAX_OPEN_TRADES=2
ASB1_ALLOW_LONGS=1
ASB1_ALLOW_SHORTS=0
ASB1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT
BOUNCE1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT,DOTUSDT
ASB1_MIN_RSI=30.0
ASB1_MAX_RSI=42.0
ASB1_SL_ATR_MULT=0.85
ASB1_TP1_FRAC=0.60
ASB1_TIME_STOP_BARS_5M=576

## ── flat — tight для bull_chop (наш red month) ───────────────────────────────
ARF1_SYMBOL_ALLOWLIST=ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ARF1_MIN_RSI=58.0
ARF1_SL_ATR_MULT=0.55

## ── midterm — BTC/ETH only ───────────────────────────────────────────────────
MIDTERM_SYMBOLS=BTCUSDT,ETHUSDT
