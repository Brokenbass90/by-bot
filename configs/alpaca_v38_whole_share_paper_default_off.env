## Alpaca v38 whole-share PAPER profile — intentionally default-off.
## This profile is for lifecycle and sizing evidence only. It grants no money
## authority and must not be reused with the live broker endpoint.

ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_SEND_ORDERS=0
ALPACA_ALLOW_NEW_ENTRIES=0
ALPACA_CLOSE_STALE_POSITIONS=0
MONTHLY_MIDMONTH_ROTATION=0

ALPACA_CAPITAL_OVERRIDE_USD=5000
ALPACA_MAX_POSITIONS=3
ALPACA_TARGET_ALLOC_PCT=0.70
ALPACA_MIN_DOLLAR_ORDER=25
ALPACA_WHOLE_SHARE_ONLY=1

# Isolate every paper artefact from the active and live Alpaca runtimes.
ALPACA_AUTOPILOT_RUNTIME_DIR=runtime/equities_monthly_v38_whole_share_paper
EQ_V36_RUNTIME_DIR=runtime/equities_monthly_v38_whole_share_paper
ALPACA_PICKS_CSV=runtime/equities_monthly_v38_whole_share_paper/current_cycle_picks.csv
ALPACA_CURRENT_CYCLE_PICKS_CSV=runtime/equities_monthly_v38_whole_share_paper/current_cycle_picks.csv
MONTHLY_HWM_STATE_PATH=runtime/equities_monthly_v38_whole_share_paper/monthly_hwm.json
MONTHLY_REENTRY_BLOCK_STATE_PATH=runtime/equities_monthly_v38_whole_share_paper/reentry_block.json
ALPACA_PROTECTIVE_EXIT_RUNTIME_DIR=runtime/equities_monthly_v38_whole_share_paper/protective_exit

ALPACA_BROKER_PROTECTION_ENABLE=1
ALPACA_BROKER_PROTECTION_REQUIRED=1
ALPACA_BROKER_PROTECTION_ORDER_CLASS=simple_stop
ALPACA_BROKER_PROTECTION_SIZE_MODE=qty
ALPACA_BROKER_PROTECTION_TIF=gtc

MONTHLY_TRAIL_ENABLE=1
MONTHLY_TRAIL_MIN_GAIN_PCT=3.5
MONTHLY_TRAIL_PCT=0.035
ALPACA_NATIVE_TRAIL_ENABLE=0
ALPACA_NATIVE_TRAIL_REQUIRED=0
ALPACA_NATIVE_TRAIL_TIF=gtc
ALPACA_NATIVE_TRAIL_MIN_GAIN_PCT=3.5
ALPACA_NATIVE_TRAIL_PERCENT=3.5
