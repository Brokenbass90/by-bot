## Alpaca monthly v38-active paper candidate
## Created: 2026-05-19
##
## Purpose:
## - run the more-active monthly v38 sleeve through the same paper bridge safety
##   envelope as the current v38 hybrid candidate
## - keep this separate from research-only v38-active config
## - simulate the first real-size Alpaca tranche with $500 capital override
##
## Current evidence:
## - 2024-05..2026-04 server refresh: +59.78%, PF 8.22, WR 83.87%,
##   31 trades, max monthly DD -3.86%
## - runtime: runtime/equities_monthly_v38_more_active_research
##
## Safety:
## - default bridge command should be run with ALPACA_SEND_ORDERS=0 first
## - paper orders only after dry-run report is clean
## - this file does not contain Alpaca keys

ALPACA_AUTOPILOT_REFRESH=0
ALPACA_AUTOPILOT_RUNTIME_DIR=runtime/equities_monthly_v38_more_active_research
EQ_V36_RUNTIME_DIR=runtime/equities_monthly_v38_more_active_research
ALPACA_PICKS_CSV=runtime/equities_monthly_v38_more_active_research/current_cycle_picks.csv

EQ_V36_TAG=equities_monthly_v38_more_active_paper_candidate
EQ_V36_SIM_START_MONTH=2024-05
EQ_V36_SIM_END_MONTH=2026-04
EQ_V36_SIM_MAX_HOLD_DAYS=20
EQ_V36_SIM_MIN_MOM_LOOKBACK_PCT=0.0
EQ_V36_SIM_STOP_ATR_MULT=2.0
EQ_V36_SIM_TARGET_ATR_MULT=2.8
EQ_V36_SIM_INTRAMONTH_PORTFOLIO_STOP_PCT=0.08
EQ_V36_SIM_BE_TRIGGER_R=0.8
EQ_V36_SIM_TRAIL_ATR_MULT=1.5

EQ_V36_CURRENT_TOP_N=3
EQ_V36_CURRENT_UNIVERSE_TOP_K=14
EQ_V36_CURRENT_MIN_MOM_LOOKBACK_PCT=0.0
EQ_V36_CURRENT_PULLBACK_MIN_PCT=-12.0
EQ_V36_CURRENT_PULLBACK_MAX_PCT=-1.5

EQ_V36_SIM_REGIME_MIN_BREADTH_SMA_PCT=45
EQ_V36_SIM_REGIME_MIN_BREADTH_MOM_PCT=45
EQ_V36_SIM_REGIME_MIN_AVG_MOM_PCT=0.0

## Paper bridge sizing. Keep first test equal to planned first real tranche.
ALPACA_MAX_POSITIONS=3
ALPACA_TARGET_ALLOC_PCT=0.70
ALPACA_MIN_DOLLAR_ORDER=25
ALPACA_CAPITAL_OVERRIDE_USD=500
ALPACA_CLOSE_STALE_POSITIONS=0
ALPACA_MAX_PICK_AGE_DAYS=45
ALPACA_REFRESH_GRACE_HOURS=72

## Monthly sleeve protection.
MONTHLY_ATR_SIZING=1
MONTHLY_WEIGHTED_SIZING=1
MONTHLY_SL_ENABLE=1
MONTHLY_SL_PCT=0.05
MONTHLY_TRAIL_ENABLE=1
MONTHLY_TRAIL_MIN_GAIN_PCT=3.5
MONTHLY_TRAIL_PCT=0.035
MONTHLY_MIDMONTH_ROTATION=1
MONTHLY_MIDMONTH_DAY=14
MONTHLY_MIDMONTH_DD_PCT=0.05

## Broker-side protection. Alpaca fractional accounts cannot use native
## bracket/trailing for every case, so the bridge uses market entry + stop,
## then promotes whole-share winners to native trailing_stop when possible.
ALPACA_BROKER_PROTECTION_ENABLE=1
ALPACA_BROKER_PROTECTION_REQUIRED=1
ALPACA_BROKER_PROTECTION_ORDER_CLASS=simple_stop
ALPACA_BROKER_PROTECTION_SIZE_MODE=qty
ALPACA_BROKER_PROTECTION_TIF=day
ALPACA_BROKER_PROTECTION_WAIT_FILL_SEC=20
ALPACA_NATIVE_TRAIL_ENABLE=1
ALPACA_NATIVE_TRAIL_REQUIRED=0
ALPACA_NATIVE_TRAIL_TIF=day
ALPACA_NATIVE_TRAIL_MIN_GAIN_PCT=3.5
ALPACA_NATIVE_TRAIL_PERCENT=3.5
ALPACA_NATIVE_TRAIL_CANCEL_EXISTING_STOPS=1
MONTHLY_REENTRY_BLOCK_ENABLE=1
MONTHLY_TRAIL_REENTRY_BLOCK_DAYS=21

