## Crypto income live canary v1 — 2026-04-28
##
## Evidence:
## - dynamic no-breakdown replay: +45.30%, PF 1.489, DD 5.77%, 454 trades,
##   1 red month over 11 populated monthly windows.
## - breakdown_v1 is excluded because dynamic attribution is negative.
## - ATT1+flat is better than ATT1-only; flat adds income but needs monitoring
##   in bull_chop.
##
## This is a candidate file only. Do not deploy without explicit approval.

ENABLE_ATT1_TRADING=1
ENABLE_FLAT_TRADING=1
ENABLE_MIDTERM_TRADING=1

ENABLE_BREAKDOWN_TRADING=0
ENABLE_BREAKOUT_TRADING=0
ENABLE_RANGE_TRADING=0
ENABLE_BOUNCE_TRADING=0
ENABLE_IMPULSE_TRADING=0
ENABLE_ASM1_TRADING=0

RISK_PER_TRADE_PCT=1.0
BYBIT_LEVERAGE=3
MAX_POSITIONS=3
MAX_OPEN_PORTFOLIO_RISK_PCT=2.0

ATT1_MAX_OPEN_TRADES=2
FLAT_MAX_OPEN_TRADES=1

## Canary risk: allocator and regime still apply on top of these.
ORCH_GLOBAL_RISK_MULT=0.50
ATT1_RISK_MULT=0.75
FLAT_RISK_MULT=0.50
MIDTERM_RISK_MULT=0.50

## ATT1 density profile from the winning static/dynamic family.
ATT1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ATT1_PIVOT_LEFT=2
ATT1_PIVOT_RIGHT=3
ATT1_MIN_PIVOTS=2
ATT1_MAX_PIVOT_AGE=20
ATT1_MIN_R2=0.7
ATT1_TOUCH_ATR=0.5
ATT1_RSI_LONG_MAX=52
ATT1_RSI_SHORT_MIN=40

## ARF1 / flat stabilizer. Keep one open trade max in canary.
ARF1_SYMBOL_ALLOWLIST=ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ARF1_MIN_RSI=52.0
ARF1_SL_ATR_MULT=0.60
ARF1_TP1_FRAC=0.60
ARF1_TP2_BUFFER_PCT=0.45
ARF1_TRAIL_ATR_MULT=0.0
ARF1_TIME_STOP_BARS_5M=576
ARF1_REJECT_BELOW_RES_ATR=0.12
ARF1_MAX_CLOSE_VS_EMA_PCT=1.2

MIDTERM_SYMBOLS=BTCUSDT,ETHUSDT
