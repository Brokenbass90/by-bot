## Crypto income live canary v2.1 — 2026-05-03 (Claude — bull_chop fix)
##
## ROOT CAUSE FIX: canary v2 дал 0 сделок за 5 дней (28 апр - 3 мая) потому что:
##   1. Регим сменился bear_chop → bull_chop ~30 апр.
##   2. regime_overlay_bull_chop.env НЕ СУЩЕСТВОВАЛ — overlay-покрытие 75% не 100%.
##   3. Мой ARF1 guard в canary_v2 policy душил flat.bull_chop=0.25 → ARF1 риск ~0.
##   4. REGIME_OVERLAY_ENABLE=0 заблокировал hot-reload — даже если бы файл был, бот бы его не читал.
##
## v2.1 fixes:
##   ✓ Создан configs/regime_overlay_bull_chop.env с полным набором ENABLE-флагов.
##   ✓ Создан configs/portfolio_allocator_policy_canary_v2_1.json (flat.bull_chop=0.65).
##   ✓ REGIME_OVERLAY_ENABLE=1 — hot-reload включён.
##   ✓ Включены ASB1 (bounce — primary long в bull_chop), IVB1 (research mode).
##   ✓ Включён dynamic re-deploy через build_portfolio_allocator.py при смене режима.
##
## Evidence base (canary v2):
##   - dynamic 11-window replay: +45.44%, PF 1.493, DD 5.95%, 456 trades
##   - 5 days live (28 апр - 3 мая): 0 trades — нужен v2.1.
##
## Этот файл — кандидат на patch. Применять только после backtest v2 vs v2.1
## за последние 60d (включая bull_chop window).

ENABLE_ATT1_TRADING=1
ENABLE_FLAT_TRADING=1
ENABLE_MIDTERM_TRADING=1

## Включаем bounce и impulse — overlay'ы фильтруют по режиму
ENABLE_BOUNCE_TRADING=1
ENABLE_IMPULSE_TRADING=1

## V6-неподтверждённые
ENABLE_BREAKDOWN_TRADING=0
ENABLE_BREAKOUT_TRADING=1   ## breakout overlay управляет per-режим
ENABLE_RANGE_TRADING=0       ## range пока в разработке (Pair 1 показал shaky)
ENABLE_ASM1_TRADING=0

## V7 sleeves — все OFF (как в canary v2)
ENABLE_BREAKDOWN2_TRADING=0
ENABLE_SLOPE_CHOCH_TRADING=0
ENABLE_LC_TRADING=0
ENABLE_FR_TRADING=0
ENABLE_MSCALP_TRADING=0
ENABLE_SOB1_TRADING=0
ENABLE_VWAP_TRADING=0

## ВКЛЮЧАЕМ regime overlay hot-reload — без этого все мои фиксы бесполезны.
REGIME_OVERLAY_ENABLE=1

RISK_PER_TRADE_PCT=1.0
BYBIT_LEVERAGE=3
MAX_POSITIONS=3
MAX_OPEN_PORTFOLIO_RISK_PCT=2.0

ATT1_MAX_OPEN_TRADES=2
FLAT_MAX_OPEN_TRADES=1
ASB1_MAX_OPEN_TRADES=1
IVB1_MAX_OPEN_TRADES=1

## Canary risk
ORCH_GLOBAL_RISK_MULT=0.55
ATT1_RISK_MULT=0.85
FLAT_RISK_MULT=0.55
MIDTERM_RISK_MULT=0.55
BOUNCE_RISK_MULT=0.55
IMPULSE_RISK_MULT=0.40
BREAKOUT_RISK_MULT=0.40

## ATT1 базовая density (overlay переопределит RSI per regime)
ATT1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ATT1_PIVOT_LEFT=2
ATT1_PIVOT_RIGHT=3
ATT1_MIN_PIVOTS=2
ATT1_MAX_PIVOT_AGE=20
ATT1_MIN_R2=0.7
ATT1_TOUCH_ATR=0.5

MIDTERM_SYMBOLS=BTCUSDT,ETHUSDT
