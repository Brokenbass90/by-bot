## Crypto income ARF1 r002 strict-three-slot shadow candidate - 2026-05-26
##
## Purpose:
## - keep only the proven crypto_income_static_v1 four-sleeve package;
## - apply the ARF1 r002 full-package winner parameters;
## - validate against current live-style concurrency (3 positions) before live use.
##
## Fixed server-cache research evidence, 365d ending 2026-04-25:
## - static_v1 baseline, MAX_POSITIONS=3: +62.79%, PF 1.478, DD 5.36%, 3 red months
## - this r002 candidate, MAX_POSITIONS=3: +67.11%, PF 1.530, DD 4.82%, 2 red months
## - this r002 candidate, MAX_POSITIONS=5: +77.57%, PF 1.646, DD 5.16%, 2 red months
##
## Shadow/review only. Do not source into the live bot without explicit approval.
## `MAX_POSITIONS` is supplied by BYBIT_ACCOUNTS_JSON.trade, not by this file.
## Initial live proposal, if approved: retain max_positions=3 and leverage=3;
## apply the portfolio and same-direction caps below before enabling this package.

ENABLE_ATT1_TRADING=1
ENABLE_FLAT_TRADING=1
ENABLE_BREAKDOWN_TRADING=1
ENABLE_MIDTERM_TRADING=1
ENABLE_BREAKOUT_TRADING=0
ENABLE_SLOPED_TRADING=0
ENABLE_RANGE_TRADING=0
ENABLE_BOUNCE_TRADING=0
ENABLE_IMPULSE_TRADING=0
ENABLE_ASM1_TRADING=0

## Safety gates required for a controlled live canary.
MAX_OPEN_PORTFOLIO_RISK_PCT=1.50
MAX_SAME_DIRECTION_POSITIONS=2

## ATT1 proven static-v1 profile.
ATT1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ATT1_PIVOT_LEFT=2
ATT1_PIVOT_RIGHT=3
ATT1_MIN_PIVOTS=2
ATT1_MAX_PIVOT_AGE=20
ATT1_MIN_R2=0.7
ATT1_TOUCH_ATR=0.5
ATT1_RSI_LONG_MAX=52
ATT1_RSI_SHORT_MIN=40

## Breakdown_v1 proven static-v1 profile.
BREAKDOWN_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ADAUSDT
BREAKDOWN_ALLOW_SHORTS=1
BREAKDOWN_ALLOW_FAILED_RECLAIM=1
BREAKDOWN_ALLOW_CONTINUATION=1
BREAKDOWN_REGIME_MODE=ema
BREAKDOWN_REGIME_MIN_ER=0.15
BREAKDOWN_REGIME_ER_BARS=20
BREAKDOWN_LOOKBACK_H=48
BREAKDOWN_RSI_MAX=55
BREAKDOWN_BUFFER_ATR=0.10
BREAKDOWN_MIN_BREAK_ATR=0.20
BREAKDOWN_IMPULSE_BODY_MIN_FRAC=0.35
BREAKDOWN_MAX_DIST_ATR=2.0
BREAKDOWN_SL_ATR=1.8
BREAKDOWN_RR=2.0
BREAKDOWN_TP1_FRAC=0.50
BREAKDOWN_MAX_RETEST_BARS=30
BREAKDOWN_TIME_STOP_BARS_5M=288
BREAKDOWN_COOLDOWN_BARS_5M=48

## ARF1 r002 package winner.
ARF1_SYMBOL_ALLOWLIST=ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ARF1_MIN_RSI=48
ARF1_SL_ATR_MULT=0.60
ARF1_TP1_FRAC=0.60
ARF1_TP2_BUFFER_PCT=0.45
ARF1_TRAIL_ATR_MULT=0.0
ARF1_TIME_STOP_BARS_5M=576
ARF1_REJECT_BELOW_RES_ATR=0.08
ARF1_RES_TOUCH_BUFFER_ATR=0.35
ARF1_MAX_CLOSE_VS_EMA_PCT=1.2

## BTC/ETH midterm sleeve.
MIDTERM_SYMBOLS=BTCUSDT,ETHUSDT

## Portfolio-level cooldown from the proven package.
PORTFOLIO_GLOBAL_SL_COOLDOWN_BARS=48
PORTFOLIO_GLOBAL_SL_STRATEGIES=alt_inplay_breakdown_v1
