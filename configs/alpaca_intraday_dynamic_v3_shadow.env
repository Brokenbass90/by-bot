# Third paper sleeve for Alpaca intraday dynamic testing.
# Keeps its own state, equity log, advisory runtime, and config output
# so it can run alongside the current paper branch without collisions.

INTRADAY_STATE_FILE=configs/intraday_state_v3_shadow.json
INTRADAY_EQUITY_LOG_FILE=configs/intraday_equity_log_v3_shadow.json
INTRADAY_ADVISORY_DIR=runtime/equities_intraday_dynamic_v3_shadow
INTRADAY_MONTHLY_RUNTIME_DIR=runtime/equities_monthly_v36

INTRADAY_CONFIG_FILE=configs/intraday_config_broad_trend.json
INTRADAY_DATA_DIR=data_cache/equities_1h
INTRADAY_DYNAMIC_SYMBOL_POOL=
INTRADAY_DYNAMIC_MAX_SYMBOLS=16
INTRADAY_DYNAMIC_BREAKOUT_TARGET=8
INTRADAY_DYNAMIC_REVERSION_TARGET=8
INTRADAY_DYNAMIC_MIN_AVG_DOLLAR_VOL=15000000
INTRADAY_DYNAMIC_BREAKOUT_CLASS=trend_retest
INTRADAY_DYNAMIC_REVERSION_CLASS=trend_pullback_rebound:quality_guard

INTRADAY_NOTIONAL_USD=1000
INTRADAY_MAX_POSITIONS=3
INTRADAY_SPY_GATE=1
INTRADAY_SPY_SMA_PERIOD=50
INTRADAY_MAX_DAILY_LOSS_PCT=1.5
INTRADAY_EQUITY_CURVE_GATE=1
INTRADAY_EQUITY_CURVE_DAYS=20
INTRADAY_AUTODISCOVER_FROM_CACHE=1
INTRADAY_DYNAMIC_BUILD=1
INTRADAY_CLOSE_UNKNOWN_REMOTE_POSITIONS=0

# Research helpers
EQ_WF_TOP_N=12
EQ_MIN_TRADES=12
