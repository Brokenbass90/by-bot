## Crypto income live canary v2 — 2026-04-28 (Claude расширение Codex v1)
##
## Базируется на configs/crypto_income_live_canary_v1.env (Codex, 2026-04-28).
## Дополнено Claude:
##   1. ENABLE_*=0 для пяти v7-sleeves + breakdown_v2 — закрыть невидимую утечку,
##      потому что v1 не отключает v7-рукава, и они унаследуют свои allocator
##      multipliers и продолжат торговать без WF-22.
##   2. ARF1 guard для bull_chop — единственный red month canary v1 был от ARF1
##      в bull_chop. Понижаем FLAT_RISK_MULT_BULL_CHOP, оставляем рукав активным
##      в остальных режимах.
##
## Evidence v1 base (Codex):
##   - dynamic no-breakdown replay: +45.30%, PF 1.489, DD 5.77%, 454 trades,
##     1 red month over 11 populated monthly windows.
##   - breakdown_v1 excluded — dynamic attribution negative.
##   - ATT1+flat better than ATT1-only; flat additive but bull_chop-sensitive.
##
## Проверено Codex 2026-04-28:
##   - dynamic annual replay: +45.44%, PF 1.493, DD 5.95%, 456 trades,
##     1 red month over 11 populated monthly windows.
##   - active sleeves in replay: flat, ATT1, midterm only.
## Этот файл — live canary deploy profile.

ENABLE_ATT1_TRADING=1
ENABLE_FLAT_TRADING=1
ENABLE_MIDTERM_TRADING=1

## V6-неподтверждённые (как в v1)
ENABLE_BREAKDOWN_TRADING=0
ENABLE_BREAKOUT_TRADING=0
ENABLE_RANGE_TRADING=0
ENABLE_BOUNCE_TRADING=0
ENABLE_IMPULSE_TRADING=0
ENABLE_IVB1_TRADING=0
ENABLE_ASM1_TRADING=0
ENABLE_SLOPED_TRADING=0
ENABLE_ASB1_TRADING=0
ENABLE_HZBO1_TRADING=0
ENABLE_BOUNCE1_TRADING=0
ENABLE_PUMP_FADE_TRADING=0
ENABLE_ELDER_TRADING=0
ENABLE_ETS3_TRADING=0
ENABLE_MTSV1_TRADING=0
ENABLE_MTSV2_TRADING=0

## V7-неподтверждённые (НОВОЕ в v2 — закрытие утечки)
## Все 5 v7-рукавов выключены до прохождения WF-22.
## ROADMAP_SELF_IMPROVING.md явно рекомендует это, AUDIT_REPORT_20260427
## подтвердил отсутствие свежих WF-22 для всех пяти.
ENABLE_BREAKDOWN2_TRADING=0
ENABLE_SLOPE_CHOCH_TRADING=0
ENABLE_LC_TRADING=0
ENABLE_FR_TRADING=0
ENABLE_MSCALP_TRADING=0

## Дополнительно — отключаем sob1 и vwap_mr на канарее.
## sob1 ни разу не WF-22 в этом репо, vwap_mr давал 0 сделок раньше.
ENABLE_SOB1_TRADING=0
ENABLE_VWAP_TRADING=0

## Отдельные direction-флаги (на случай если allocator policy включает их через overlay)
LC_ALLOW_LONGS=0
LC_ALLOW_SHORTS=0
MSCALP_ALLOW_LONGS=0
MSCALP_ALLOW_SHORTS=0

## На canary запрещаем прямое применение raw regime overlay в live-боте:
## orchestrator всё ещё обновляет state, а allocator применяет свежий regime
## через canary policy. Это убирает окно, где raw-orchestrator может включить
## v7/breakdown/vwap до повторного allocator reload.
PORTFOLIO_ALLOCATOR_ENABLE=1
REGIME_OVERLAY_ENABLE=0

RISK_PER_TRADE_PCT=1.0
BYBIT_LEVERAGE=3
MAX_POSITIONS=3
MAX_OPEN_PORTFOLIO_RISK_PCT=2.0

ATT1_MAX_OPEN_TRADES=2
FLAT_MAX_OPEN_TRADES=1

## Canary risk: allocator и regime ещё применяются сверху.
ORCH_GLOBAL_RISK_MULT=0.50
ATT1_RISK_MULT=0.75
FLAT_RISK_MULT=0.50
MIDTERM_RISK_MULT=0.50

## ARF1 bull_chop guard (НОВОЕ в v2)
##
## Per-regime sleeve mult задаётся ТОЛЬКО в JSON policy (env не читается
## allocator'ом — проверено в build_portfolio_allocator.py:42-256).
## Поэтому bull_chop guard реализован отдельным policy-файлом:
##   configs/portfolio_allocator_policy_canary_v2.json
## где flat.base_risk_mult_by_regime.bull_chop понижен с 1.0 до 0.25.
##
## На сервере для canary deploy файл
##   configs/portfolio_allocator_policy_canary_v2.json
## копируется поверх configs/portfolio_allocator_policy.json, потому что cron
## запускает allocator с default policy path. Rollback — восстановить backup из
## runtime/server_backups/.

## ATT1 density profile (как в v1)
ATT1_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ATT1_PIVOT_LEFT=2
ATT1_PIVOT_RIGHT=3
ATT1_MIN_PIVOTS=2
ATT1_MAX_PIVOT_AGE=20
ATT1_MIN_R2=0.7
ATT1_TOUCH_ATR=0.5
ATT1_RSI_LONG_MAX=52
ATT1_RSI_SHORT_MIN=40

## ARF1 / flat (как в v1)
ARF1_SYMBOL_ALLOWLIST=ADAUSDT,LINKUSDT,LTCUSDT,DOTUSDT,SUIUSDT
ARF1_MIN_RSI=52.0
ARF1_SL_ATR_MULT=0.60
ARF1_TP1_FRAC=0.60
ARF1_TP2_BUFFER_PCT=0.45
ARF1_TRAIL_ATR_MULT=0.0
ARF1_TIME_STOP_BARS_5M=576
ARF1_REJECT_BELOW_RES_ATR=0.12
ARF1_MAX_CLOSE_VS_EMA_PCT=1.2

MIDTERM_SYMBOLS=BTCUSDT,ETHUSDT
MTPB_VERSION=1
