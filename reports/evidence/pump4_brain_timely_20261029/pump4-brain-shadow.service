[Unit]
Description=PUMP4 public-data Brain paired shadow (no financial authority)
After=local-fs.target

[Service]
Type=simple
User=root
RootDirectory=/opt/bybot-research/pump4-brain-shadow-20261029-v1/jail
WorkingDirectory=/app
BindReadOnlyPaths=/usr:/usr /usr/lib:/lib /usr/lib64:/lib64
BindReadOnlyPaths=/opt/bybot-research/pump4-brain-shadow-20261029-v1/app:/app
BindReadOnlyPaths=/opt/bybot-research/pump4-server-orders-off-20261023/candidate-7d8ae05dab162ec5/app/.private/pump4-supervisor-v1/ws-hours:/source
BindPaths=/opt/bybot-research/pump4-brain-shadow-20261029-v1/runtime:/runtime
ExecStart=/usr/bin/python3 -I -B /app/scripts/run_pump4_brain_timely_v1.py --source /source --runtime /runtime --manifest /app/reports/evidence/pump4_brain_timely_20261029/source-manifest.json --manifest-sha256 79c6cfc04489266e1ba9e0a0cdc2250d82c3959ad907cf005e7d46c432fb29e2
Restart=no
RuntimeMaxSec=7d
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/runtime
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
